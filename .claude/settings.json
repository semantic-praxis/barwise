{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "env -u BARWISE_EXIT_DIR bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "env -u BARWISE_EXIT_DIR bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "env -u BARWISE_EXIT_DIR \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "env -u BARWISE_EXIT_DIR node \"$CLAUDE_PROJECT_DIR/barwise/scripts/hooks/masked-exit.mjs\" session",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env -u BARWISE_EXIT_DIR node \"$CLAUDE_PROJECT_DIR/barwise/scripts/hooks/python-uv-guard.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env -u BARWISE_EXIT_DIR node \"$CLAUDE_PROJECT_DIR/barwise/scripts/hooks/masked-exit.mjs\" post"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env -u BARWISE_EXIT_DIR node \"$CLAUDE_PROJECT_DIR/barwise/scripts/hooks/masked-exit.mjs\" failure"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "env -u BARWISE_EXIT_DIR node \"$CLAUDE_PROJECT_DIR/barwise/scripts/hooks/masked-exit.mjs\" stop"
          }
        ]
      }
    ]
  }
}
