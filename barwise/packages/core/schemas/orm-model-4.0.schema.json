{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://orm-modeler.dev/schemas/v1/orm-model-4.0.schema.json",
  "title": "ORM Domain Model",
  "description": "Schema for .orm.yaml domain model files used by Barwise.",
  "type": "object",
  "required": [
    "orm_version",
    "model"
  ],
  "additionalProperties": false,
  "properties": {
    "orm_version": {
      "type": "string",
      "const": "4.0",
      "description": "Schema version. Must be \"4.0\" for this schema revision."
    },
    "model": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name for this domain model."
        },
        "domain_context": {
          "type": "string",
          "minLength": 1,
          "description": "The bounded context this model represents (e.g. \"ecommerce\")."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S*[/#]$",
          "description": "The absolute IRI this model's element IRIs start with, ending in / or #. For a model outside a project that declares iri_base; in such a project the project's namespace wins."
        },
        "imports": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/local_name"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "The contexts this model refers to, each by the alias its references use: alias to a context name or an absolute IRI."
        },
        "note": {
          "type": "string",
          "description": "Free-text model-level note, distinct from formal definitions."
        },
        "object_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/object_type"
          },
          "description": "The object types (entity and value types) in this model."
        },
        "fact_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fact_type"
          },
          "description": "The fact types (relationships) in this model."
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/external_constraint"
          },
          "description": "Constraints that live in the model rather than in one fact type: across fact types, or over subtypes."
        },
        "subtype_facts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/subtype_fact"
          },
          "description": "Subtype relationships between entity types."
        },
        "objectified_fact_types": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/objectified_fact_type"
          },
          "description": "Fact types that are simultaneously entity types (objectification/nesting)."
        },
        "populations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/population"
          },
          "description": "Sample fact instance populations used for constraint validation."
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/definition"
          },
          "description": "Ubiquitous language entries not directly attached to a model element."
        },
        "diagrams": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/diagram_layout"
          },
          "description": "Persisted diagram layouts with element positions and fact type orientations."
        }
      }
    }
  },
  "definitions": {
    "object_type": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/reference"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "entity",
            "value"
          ],
          "description": "Whether this is an entity type or a value type."
        },
        "reference_mode": {
          "type": "string",
          "minLength": 1,
          "description": "The reference mode for entity types (e.g. \"customer_id\"). Required for entity types."
        },
        "definition": {
          "type": "string",
          "description": "Natural-language definition for the ubiquitous language."
        },
        "source_context": {
          "type": "string",
          "description": "The bounded context this object type originates from."
        },
        "value_constraint": {
          "$ref": "#/definitions/value_constraint_def",
          "description": "Value constraint for value types."
        },
        "data_type": {
          "$ref": "#/definitions/data_type_def",
          "description": "Conceptual data type for value types (e.g. text, integer, decimal)."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Alternative names for this object type (synonyms from different stakeholders or contexts)."
        },
        "independent": {
          "type": "boolean",
          "description": "Whether the object type is independent: its instances may exist without participating in any non-identifying fact."
        },
        "default_value": {
          "type": "string",
          "description": "Default value for a value type, threaded into relational mapping as a SQL column DEFAULT."
        },
        "note": {
          "type": "string",
          "description": "Free-text note, informal commentary distinct from the formal definition."
        },
        "cardinality": {
          "$ref": "#/definitions/cardinality_range_def",
          "description": "Bound on this object type's population (number of instances)."
        },
        "preferred_identifier": {
          "$ref": "#/definitions/local_name"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "entity"
          }
        }
      },
      "then": {
        "required": [
          "reference_mode"
        ],
        "properties": {
          "data_type": false,
          "value_constraint": false,
          "default_value": false
        }
      },
      "else": {
        "properties": {
          "preferred_identifier": false
        }
      }
    },
    "role_path_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "steps"
      ],
      "description": "A declared role path: a root object type (the join variable) and ordered single-fact-type hops.",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1,
          "description": "The root object type id -- the correlation / join variable's type."
        },
        "steps": {
          "type": "array",
          "description": "The ordered hops; empty means the path is just the root.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry",
              "exit"
            ],
            "properties": {
              "entry": {
                "type": "string",
                "minLength": 1,
                "description": "Entry role id (played by the current path node)."
              },
              "exit": {
                "type": "string",
                "minLength": 1,
                "description": "Exit role id (another role of the entry role's fact type)."
              }
            }
          }
        }
      }
    },
    "join_operand_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "projection"
      ],
      "description": "A join-constraint operand: a role path plus the projection selecting which path nodes form the compared tuple.",
      "properties": {
        "path": {
          "$ref": "#/definitions/role_path_def",
          "description": "The role path this operand projects from."
        },
        "projection": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Path-node indices (0 = root, k = after step k) forming the compared tuple, in order."
        }
      }
    },
    "ring_type_def": {
      "type": "string",
      "enum": [
        "irreflexive",
        "asymmetric",
        "antisymmetric",
        "intransitive",
        "acyclic",
        "symmetric",
        "transitive",
        "purely_reflexive"
      ],
      "description": "The ring property being constrained."
    },
    "cardinality_range_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of instances (inclusive)."
        },
        "max": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "const": "unbounded"
            }
          ],
          "description": "Maximum number of instances, or \"unbounded\"."
        }
      }
    },
    "value_range_def": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "string",
          "description": "Lower bound; omit for open-below."
        },
        "max": {
          "type": "string",
          "description": "Upper bound; omit for open-above."
        },
        "min_inclusive": {
          "type": "boolean",
          "description": "Lower bound inclusive (default true)."
        },
        "max_inclusive": {
          "type": "boolean",
          "description": "Upper bound inclusive (default true)."
        }
      },
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ]
    },
    "value_constraint_def": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Enumerated allowed values."
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/value_range_def"
          },
          "minItems": 1,
          "description": "Allowed value ranges (inclusive/exclusive, possibly open-ended)."
        }
      },
      "anyOf": [
        {
          "required": [
            "values"
          ]
        },
        {
          "required": [
            "ranges"
          ]
        }
      ]
    },
    "data_type_def": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "text",
            "integer",
            "decimal",
            "money",
            "float",
            "boolean",
            "date",
            "time",
            "datetime",
            "timestamp",
            "auto_counter",
            "binary",
            "uuid",
            "other"
          ],
          "description": "Portable conceptual data type name."
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "description": "Length parameter (e.g. VARCHAR length)."
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "description": "Scale parameter (e.g. decimal scale)."
        }
      }
    },
    "role": {
      "type": "object",
      "required": [
        "id",
        "player",
        "role_name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/role_id"
        },
        "player": {
          "$ref": "#/definitions/reference"
        },
        "role_name": {
          "type": "string",
          "minLength": 1,
          "description": "The role name used in verbalization."
        }
      }
    },
    "fact_type": {
      "type": "object",
      "required": [
        "id",
        "name",
        "roles",
        "readings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/local_name"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable name (typically the forward reading)."
        },
        "definition": {
          "type": "string",
          "description": "Natural-language definition."
        },
        "note": {
          "type": "string",
          "description": "Free-text note, informal commentary distinct from the formal definition."
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/role"
          },
          "minItems": 1,
          "description": "Ordered roles in this fact type."
        },
        "readings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Reading templates with positional placeholders."
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/internal_constraint"
          },
          "description": "The fact type's own constraints: the internal kinds only."
        },
        "derivation": {
          "$ref": "#/definitions/derivation_rule_def",
          "description": "Derivation rule when this fact type is derived; absent for an asserted fact type."
        }
      }
    },
    "derivation_rule_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expression"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "derived",
            "semiderived"
          ],
          "description": "Definitional axis: fully derived (*) or semiderived (+)."
        },
        "storage": {
          "type": "string",
          "enum": [
            "derive_on_request",
            "derived_and_stored"
          ],
          "description": "Storage axis: on-request (*, default) or stored (**)."
        },
        "expression": {
          "type": "string",
          "description": "The rule text (natural language or hand-written FORML). Stored verbatim, never executed."
        },
        "is_formal": {
          "type": "boolean",
          "description": "Reserved: true once the expression is a parsed formal rule. Absent or false in v1."
        }
      }
    },
    "subtype_fact": {
      "type": "object",
      "required": [
        "subtype",
        "supertype"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/local_name"
        },
        "subtype": {
          "$ref": "#/definitions/reference"
        },
        "supertype": {
          "$ref": "#/definitions/reference"
        },
        "provides_identification": {
          "type": "boolean",
          "default": true,
          "description": "Whether the subtype uses the supertype's reference scheme for identification."
        },
        "defining_rule": {
          "$ref": "#/definitions/derivation_rule_def",
          "description": "Defining rule when this subtype's membership is determined by a derivation rule; absent for an asserted subtype."
        },
        "minted_from": {
          "$ref": "#/definitions/minted_from"
        }
      },
      "dependencies": {
        "minted_from": [
          "id"
        ]
      }
    },
    "objectified_fact_type": {
      "type": "object",
      "required": [
        "fact_type",
        "object_type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/local_name"
        },
        "fact_type": {
          "$ref": "#/definitions/local_name"
        },
        "object_type": {
          "$ref": "#/definitions/reference"
        },
        "minted_from": {
          "$ref": "#/definitions/minted_from"
        }
      },
      "dependencies": {
        "minted_from": [
          "id"
        ]
      }
    },
    "population": {
      "type": "object",
      "required": [
        "id",
        "fact_type",
        "instances"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/population_id"
        },
        "fact_type": {
          "$ref": "#/definitions/local_name"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of this population."
        },
        "sample": {
          "type": "boolean",
          "description": "True when these instances are an illustrative sample rather than the complete extension of the fact type. A sample is positive evidence only: it can satisfy a constraint but never creates the obligation that one be satisfied, so its instances are excluded from the object universe used by mandatory and cardinality checks. Absent means a significant (complete) population, checked as a closed world."
        },
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/fact_instance"
          },
          "description": "The sample fact instances in this population."
        }
      }
    },
    "fact_instance": {
      "type": "object",
      "required": [
        "id",
        "role_values"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/instance_id"
        },
        "role_values": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Mapping of role id to concrete value.",
          "propertyNames": {
            "$ref": "#/definitions/role_id"
          }
        }
      }
    },
    "definition": {
      "type": "object",
      "required": [
        "term",
        "definition"
      ],
      "additionalProperties": false,
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "description": "The term being defined."
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "description": "The natural-language definition."
        },
        "context": {
          "type": "string",
          "description": "The bounded context in which this term applies."
        }
      }
    },
    "diagram_layout": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name for this diagram view."
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/reference"
          },
          "description": "Ids of the object types included in this view. An empty list is an empty view. When absent, all elements are shown."
        },
        "positions": {
          "type": "object",
          "description": "Element positions keyed by object type or fact type id. Values are {x, y} in integer pixels, screen coordinates (0,0 top-left, x right, y down).",
          "additionalProperties": {
            "type": "object",
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer",
                "description": "Horizontal position in pixels."
              },
              "y": {
                "type": "integer",
                "description": "Vertical position in pixels."
              }
            }
          }
        },
        "orientations": {
          "type": "object",
          "description": "Fact type orientation overrides keyed by fact type id. Only includes explicitly set orientations.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "horizontal",
              "vertical"
            ]
          }
        }
      }
    },
    "internal_constraint": {
      "type": "object",
      "required": [
        "type"
      ],
      "description": "A constraint that lives in its fact type: every role it names is one of that fact type's roles.",
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "internal_uniqueness"
            },
            "id": {
              "$ref": "#/definitions/local_name"
            },
            "modality": {
              "type": "string",
              "enum": [
                "alethic",
                "deontic"
              ],
              "description": "Alethic (necessity, the default) or deontic (obligation)."
            },
            "roles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/role_id"
              },
              "minItems": 1,
              "description": "Role ids within the same fact type."
            },
            "minted_from": {
              "$ref": "#/definitions/minted_from"
            }
          },
          "required": [
            "type",
            "roles"
          ],
          "additionalProperties": false,
          "dependencies": {
            "minted_from": [
              "id"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "mandatory"
            },
            "id": {
              "$ref": "#/definitions/local_name"
            },
            "modality": {
              "type": "string",
              "enum": [
                "alethic",
                "deontic"
              ],
              "description": "Alethic (necessity, the default) or deontic (obligation)."
            },
            "role": {
              "$ref": "#/definitions/role_id"
            },
            "minted_from": {
              "$ref": "#/definitions/minted_from"
            }
          },
          "required": [
            "type",
            "role"
          ],
          "additionalProperties": false,
          "dependencies": {
            "minted_from": [
              "id"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "value_constraint"
            },
            "id": {
              "$ref": "#/definitions/local_name"
            },
            "modality": {
              "type": "string",
              "enum": [
                "alethic",
                "deontic"
              ],
              "description": "Alethic (necessity, the default) or deontic (obligation)."
            },
            "role": {
              "$ref": "#/definitions/role_id"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "Allowed enumerated values."
            },
            "ranges": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/value_range_def"
              },
              "minItems": 1,
              "description": "Allowed value ranges (inclusive/exclusive, possibly open-ended)."
            },
            "minted_from": {
              "$ref": "#/definitions/minted_from"
            }
          },
          "required": [
            "type"
          ],
          "anyOf": [
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "ranges"
              ]
            }
          ],
          "additionalProperties": false,
          "dependencies": {
            "minted_from": [
              "id"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "ring"
            },
            "id": {
              "$ref": "#/definitions/local_name"
            },
            "modality": {
              "type": "string",
              "enum": [
                "alethic",
                "deontic"
              ],
              "description": "Alethic (necessity, the default) or deontic (obligation)."
            },
            "role_1": {
              "$ref": "#/definitions/role_id"
            },
            "role_2": {
              "$ref": "#/definitions/role_id"
            },
            "ring_type": {
              "$ref": "#/definitions/ring_type_def"
            },
            "minted_from": {
              "$ref": "#/definitions/minted_from"
            }
          },
          "required": [
            "type",
            "role_1",
            "role_2",
            "ring_type"
          ],
          "additionalProperties": false,
          "dependencies": {
            "minted_from": [
              "id"
            ]
          }
        },
        {
          "properties": {
            "type": {
              "const": "frequency"
            },
            "id": {
              "$ref": "#/definitions/local_name"
            },
            "modality": {
              "type": "string",
              "enum": [
                "alethic",
                "deontic"
              ],
              "description": "Alethic (necessity, the default) or deontic (obligation)."
            },
            "role": {
              "$ref": "#/definitions/role_id"
            },
            "roles": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/role_id"
              },
              "minItems": 1,
              "description": "The role sequence being frequency-constrained (a combination)."
            },
            "min": {
              "type": "integer",
              "minimum": 1,
              "description": "Minimum occurrences."
            },
            "max": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "const": "unbounded"
                }
              ],
              "description": "Maximum occurrences, or \"unbounded\"."
            },
            "minted_from": {
