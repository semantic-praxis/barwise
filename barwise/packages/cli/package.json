{
  "name": "@barwise/cli",
  "version": "2.0.1",
  "private": true,
  "description": "CLI tool for ORM 2 modeling",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "barwise": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/chmod-bin.mjs",
    "bundle": "node esbuild.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint src/ tests/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@barwise/code-analysis": "2.0.1",
    "@barwise/core": "2.0.1",
    "@barwise/dbt": "2.0.1",
    "@barwise/diagram": "2.0.1",
    "@barwise/diagram-ui": "2.0.1",
    "@barwise/formats": "2.0.1",
    "@barwise/learn": "2.0.1",
    "@barwise/llm": "2.0.1",
    "@barwise/promptlab": "2.0.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "vitest": "^5.0.5"
  }
}
