{
  "$schema": "https://turbo.build/schema.json",
  // Turborepo 2 runs tasks in strict env mode: a variable not named here
  // never reaches the task. BARWISE_COVERAGE_DIR is how `ci:local` points
  // a run's coverage output at a directory of its own, and it was silently
  // dropped until this line existed -- the run looked isolated and wrote
  // to packages/*/coverage anyway. It is a pass-through rather than an
  // `env` input on purpose: a value that is unique per run would miss the
  // cache every time, and turn a 30s pre-push hook into a 2m40s one.
  //
  // The cost of that choice: a run with the variable set produces no
  // `coverage/**`, so turbo caches an empty output set under a hash a
  // later run WITHOUT the variable also matches, and that run replays
  // with no local coverage directory. Its verdict is still the one the
  // original run reached; only the HTML report is missing, and nothing
  // reads it -- `ci.yml` uploads no coverage artifact. A developer who
  // wants the report runs `npx vitest run --coverage` in the package,
  // which turbo does not cache at all.
  "globalPassThroughEnv": ["BARWISE_COVERAGE_DIR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // dist/bundle/ is written by each package's separate `bundle`
      // script, not by `build`. Caching it as a build output meant any
      // later cache hit on `build` -- the pre-commit hook runs one on
      // every commit -- restored whatever bundle sat in dist/ when that
      // entry was made, with a fresh mtime. The enterprise trial then
      // graded a CLI that predated two merged fixes and reported 28
      // fixed baseline rows as still open (barwise-lh9, 2026-09-26).
      "outputs": ["dist/**", "!dist/bundle/**"]
    },
    // schemas/ is read by src at run time and by tests (core's .orm.yaml
    // schemas, formats' pinned Ossie schemas). The build hash happens to
    // cover it, since build reads every package file; naming it here keeps
    // a schema-only change from replaying a cached pass if build's inputs
    // are ever narrowed.
    //
    // The rest of each list is what a cached pass also depends on
    // (docs/specs/executable-adrs.spec.md, WS2; barwise-ym8.7jz items 6, 8,
    // 10). The package's vitest.config.ts and package.json, and the shared
    // vitest.shared.ts -- $TURBO_ROOT$ is barwise/, where this file is --
    // decide which tests run and how; leaving them out replayed an old pass,
    // and an old coverage result, after a config change. examples/,
    // test-plan/ and docs/getting-started/ are the files outside a package
    // that package tests read. Not every package-only file is listed
    // ($TURBO_DEFAULT$ would make a README edit rerun the suite), and the
    // list cannot be complete: core's model corpus reads every tracked
    // .orm.yaml in the repository. A cache hit is as fresh as these inputs.
    // test-results/ holds the json report check:adr-tests reads, so a cache
    // hit restores it rather than leaving none.
    "test": {
      "dependsOn": ["build"],
      "outputs": ["test-results/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "schemas/**",
        "vitest.config.ts",
        "package.json",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/examples/**",
        "$TURBO_ROOT$/test-plan/**",
        "$TURBO_ROOT$/docs/getting-started/**"
      ]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "src/**",
        "tests/**",
        "schemas/**",
        "vitest.config.ts",
        "package.json",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/examples/**",
        "$TURBO_ROOT$/test-plan/**",
        "$TURBO_ROOT$/docs/getting-started/**"
      ]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
