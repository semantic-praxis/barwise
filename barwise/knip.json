{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["test-plan/**", "trial/**"],
  "ignoreBinaries": ["gitleaks", "pkill", "shellcheck", "uv"],
  "ignoreDependencies": ["@dprint/json", "@dprint/markdown", "@dprint/typescript"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/at-root.mjs",
        "scripts/hooks/*.mjs",
        "scripts/lib/module-count-hook.mjs",
        "scripts/tests/*.test.mjs"
      ]
    },
    "packages/core": {
      "entry": ["tests/types/*.test-d.ts"],
      "ignore": ["scripts/**", "vitest.mutation.config.ts"]
    },
    "packages/diagram": {},
    "packages/llm": {},
    "packages/promptlab": {},
    "packages/cli": {},
    "packages/mcp": {
      "entry": ["src/index.ts"]
    },
    "packages/vscode": {
      "ignore": [
        ".vscode-test.mjs",
        "tests/integration/**"
      ],
      "ignoreDependencies": [
        "@types/mocha",
        "@vscode/test-electron",
        "mocha"
      ]
    }
  }
}
