# In a linked worktree git runs this hook with GIT_DIR set and GIT_WORK_TREE
# unset or relative ("."). After the cd below, every git command would then
# take barwise/ for the top of the tree: check:secrets looked for
# barwise/.gitleaks.toml and refused every commit made from a worktree
# (barwise-hud). The hook starts at the top of the tree, so pin it here.
if [ -n "${GIT_DIR-}" ]; then
  GIT_WORK_TREE=$(pwd)
  export GIT_WORK_TREE
fi

# `|| exit` because every step below assumes this worked; without it a
# failed cd runs lint-staged and the build against the repo root.
cd barwise || exit 1

# 0. Validate the staged beads tracker when it is part of this commit. This
#    guards the cross-branch clobber (REPO_REVIEW-2026-06-23 F6) even without
#    the bd binary. Runs first so a corrupt tracker fails fast, before
#    build/test. Shared with pre-merge-commit, which git runs instead of this
#    hook for a clean merge commit.
# Its exit status passes through: 2 is "could not validate", not "invalid".
sh scripts/hooks/check-staged-tracker.sh || exit $?

# 1. Refuse a credential in what is about to be committed. This one is at
#    the COMMIT and not the push, unlike the rest of the gate list, because
#    it is the only check whose failure a later commit cannot undo: a leaked
#    key has to be rotated, and the commit is the object that gets pushed,
#    shared, stashed and copied into a worktree. `--staged` scans the index,
#    so it costs about 0.15s and -- unlike the history scan CI runs -- does
#    not care whether this clone is shallow
#    (docs/specs/credential-scanning.spec.md).
if ! npm run --silent check:secrets -- --staged; then
  echo "pre-commit: credential-shaped content in the tree (see above)." >&2
  echo "  If it is a real key, ROTATE it -- amending the commit does not un-leak it." >&2
  exit 1
fi

# 2. Lint staged files (dprint, eslint, oxlint).
npx lint-staged

# 3. Build all packages to catch cross-package type errors.
#    Turbo caches unchanged packages, so this is fast (~1s) in the
#    common case and ~3s on a full rebuild.
npm run build

# 4. Run tests in packages affected by uncommitted changes.
#    The ...[HEAD] filter selects changed packages and their dependents.
npx turbo run test --filter='...[HEAD]'

# Chain beads hook if bd is available.
if command -v bd >/dev/null 2>&1; then
  bd hooks run pre-commit "$@"
fi
