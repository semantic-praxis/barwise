# The CI gates CI selects for this change, run at the event that actually causes a red
# build. Two red pushes in one session came from gates that were simply
# not run -- `fmt:check`, then `knip` -- and a third came from running
# only the two gates I happened to be thinking about. `ci:local` derives
# its list from ci.yml, so it cannot drift out of agreement with what
# will run remotely.
#
# Pre-PUSH and not pre-commit: the full list takes minutes once a source
# file changes (measured in docs/specs/pushed-tree-verification.spec.md,
# rather than copied here to go stale). Per commit that is a hook people
# disable, and disabled is worse than absent. Per push it runs once per
# distinct pushed commit, at the boundary where CI is about to run anyway.
#
# Deliberately duplicates some of pre-commit's work (build, tests).
# Turbo caches what has not changed, and the overlap is the point: the
# commit hook checks the packages a change touches, this one checks
# everything CI checks.

# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>.
# An all-zero local sha is a branch DELETION -- there is nothing to
# validate, and pruning a merged branch should not cost three minutes.
# Each distinct commit is checked once: two refs at one commit are one tree.
# An annotated tag arrives as the tag object's sha, so each sha is peeled to
# its commit before comparing -- a release push of a branch and its tag
# would otherwise run the whole gate list twice over one tree.
shas=""
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "${local_sha}" in
    *[!0]*)
      commit=$(git rev-parse --verify --quiet "${local_sha}^{commit}" 2>/dev/null) || commit="${local_sha}"
      case " ${shas} " in
        *" ${commit} "*) ;;
        *) shas="${shas} ${commit}" ;;
      esac
      ;;
  esac
done
if [ -z "${shas}" ]; then
  exit 0
fi

cd barwise || exit 1

# Checked as CI will see it: a fresh worktree of the pushed commit, not this
# working tree, which holds build output a CI checkout lacks and files the
# push leaves behind (docs/specs/pushed-tree-verification.spec.md).
for sha in ${shas}; do
  echo "pre-push: checking ${sha} as CI will see it (npm run ci:local -- --commit)."
  echo "  ~1min warm, ~4min when sources changed."
  npm run ci:local -- --commit "${sha}"
  status=$?
  if [ "${status}" -eq 2 ]; then
    # Exit 2 is "could not answer": the worktree, the install or a gate could
    # not run. Nothing was found wrong, and nothing was shown right.
    echo >&2
    echo "pre-push: ${sha} could not be checked (see above); the gates did not all run." >&2
    echo "  Fix what stopped them, or push without the check:  git push --no-verify" >&2
    exit 1
  elif [ "${status}" -ne 0 ]; then
    echo >&2
    echo "pre-push: CI would fail on ${sha} (failing gates above)." >&2
    echo "  Fix them, or push work in progress with:  git push --no-verify" >&2
    exit 1
  fi
done
