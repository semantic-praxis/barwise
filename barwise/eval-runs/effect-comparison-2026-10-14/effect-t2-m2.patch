+/**
+ * The subtype fact, stated once: the record type, the rules a model and a
+ * file must satisfy, and the YAML spelling, as one Effect Schema definition --
+ * the object type's convention (`objectTypeSchema.ts`) applied to the next
+ * element kind (docs/specs/core-branching-load.spec.md, WS1).
+ *
+ * `SubtypeFact` is the struct's decoded type, the refusals the old class
+ * constructor made are its checks, and the YAML codec renames its keys. The
+ * JSON Schema stays hand-written, and `tests/model/subtypeFactSchemaDrift.test.ts`
+ * compares it with this one.
+ *
+ * Unlike the object type, the two spellings check exactly the same things:
+ * a subtype fact has no field whose file check was ever stricter than its
+ * code check, so a subtype fact built in code is refused exactly when the
+ * same subtype fact in a file is. The one difference is the id, which a file
+ * must carry (the JSON Schema requires it) and a caller may leave to
+ * `IdSource`.
+ */
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import type { DerivationRule } from "./FactType.js";
+import { IdSource } from "./objectTypeSchema.js";
+
+// Every `message` below is the predicate of a sentence whose subject the
+// decoder supplies ("Subtype fact "sf-1" cannot have ..."), as for the object
+// type.
+
+function nonEmptyString(what: string) {
+  return Schema.String.check(Schema.isMinLength(1, { message: `must have a non-empty ${what}.` }));
+}
+
+/**
+ * A derivation rule: how a derived element's population is defined. The
+ * record type stays `DerivationRule` in `FactType.ts`, which fact types share;
+ * `_ruleAgrees` below fails to compile when the two disagree.
+ */
+const DerivationRuleSchema = Schema.Struct({
+  kind: Schema.Literals(["derived", "semiderived"]),
+  storage: Schema.optionalKey(Schema.Literals(["derive_on_request", "derived_and_stored"])),
+  expression: Schema.String,
+  isFormal: Schema.optionalKey(Schema.Boolean),
+});
+
+type Same<A, B> = [A] extends [B] ? [B] extends [A] ? true : never : never;
+const _ruleAgrees: Same<typeof DerivationRuleSchema.Type, DerivationRule> = true;
+
+/** The YAML key of every derivation rule key that is not spelled the same. */
+export const DERIVATION_YAML_KEYS = { isFormal: "is_formal" } as const;
+
+function subtypeFactSchema(definingRule: Schema.Codec<DerivationRule, unknown>) {
+  return Schema.Struct({
+    /** Minted from `IdSource` when absent. */
+    id: nonEmptyString("id").pipe(
+      Schema.withDecodingDefaultKey(IdSource.useSync((ids) => ids.newId())),
+    ),
+    /** The id of the subtype (child) entity type. */
+    subtypeId: nonEmptyString("subtype"),
+    /** The id of the supertype (parent) entity type. */
+    supertypeId: nonEmptyString("supertype"),
+    /**
+     * Whether the subtype uses the supertype's reference scheme for
+     * identification. Always present; true unless stated otherwise.
+     */
+    providesIdentification: Schema.Boolean.pipe(
+      Schema.withDecodingDefaultKey(Effect.succeed(true)),
+    ),
+    /** Whether the subtypes of the supertype are mutually exclusive. Always present. */
+    isExclusive: Schema.Boolean.pipe(Schema.withDecodingDefaultKey(Effect.succeed(false))),
+    /** Whether the subtypes of the supertype cover all its instances. Always present. */
+    isExhaustive: Schema.Boolean.pipe(Schema.withDecodingDefaultKey(Effect.succeed(false))),
+    /** Absent for an asserted subtype. */
+    definingRule: Schema.optionalKey(definingRule),
+  }).check(
+    Schema.makeFilter(
+      (sf: { readonly subtypeId: string; readonly supertypeId: string; }) =>
+        sf.subtypeId !== sf.supertypeId,
+      { message: "cannot have the same entity as both subtype and supertype." },
+    ),
+  );
+}
+
+/** The YAML key of every subtype fact key that is not spelled the same. */
+export const SUBTYPE_YAML_KEYS = {
+  subtypeId: "subtype",
+  supertypeId: "supertype",
+  providesIdentification: "provides_identification",
+  isExclusive: "is_exclusive",
+  isExhaustive: "is_exhaustive",
+  definingRule: "defining_rule",
+} as const;
+
+/**
+ * A subtype fact as a caller of `OrmModel.addSubtypeFact` spells it, decoded
+ * into the record.
+ */
+export const SubtypeFactModelCodec = subtypeFactSchema(DerivationRuleSchema);
+
+/**
+ * A subtype fact as an `.orm.yaml` file spells it (snake_case keys), decoded
+ * into the same record.
+ */
+export const SubtypeFactYamlCodec = subtypeFactSchema(
+  DerivationRuleSchema.pipe(Schema.encodeKeys(DERIVATION_YAML_KEYS)),
+).pipe(Schema.encodeKeys(SUBTYPE_YAML_KEYS));
+
+/**
+ * A SubtypeFact represents a specialization relationship in ORM: entity type
+ * A is a subtype of entity type B. Every instance of the subtype is also an
+ * instance of the supertype; the subtype inherits all fact types and
+ * constraints of the supertype and may have additional ones of its own.
+ *
+ * Example: "Employee is a subtype of Person" means every Employee is a
+ * Person, but not every Person is necessarily an Employee.
+ *
+ * In relational mapping, subtype facts determine whether the subtype is
+ * absorbed into the supertype's table or gets its own table with a FK back
+ * to the supertype.
+ *
+ * A plain, frozen record: no class, no methods, and no name -- the class
+ * derived one (`subtype:<sub>:<super>`) that nothing displayed. Its
+ * `definingRule` is absent, never `undefined`, for an asserted subtype.
+ */
+export type SubtypeFact = typeof SubtypeFactModelCodec.Type;
