diff --git a/barwise/packages/core/tests/model/subtypeFactDecoder.test.ts b/barwise/packages/core/tests/model/subtypeFactDecoder.test.ts
new file mode 100644
index 00000000..95eaa6f5
--- /dev/null
+++ b/barwise/packages/core/tests/model/subtypeFactDecoder.test.ts
@@ -0,0 +1,286 @@
+/**
+ * The subtype fact as a sealed record (docs/specs/core-branching-load.spec.md
+ * WS1): one Effect Schema decodes a config and a file's entry into the same
+ * frozen record, refusing exactly the same subtype facts, every problem at
+ * once.
+ */
+import * as Effect from "effect/Effect";
+import * as Result from "effect/Result";
+import fc from "fast-check";
+import { afterEach, describe, expect, it } from "vitest";
+import { stringify } from "yaml";
+import { setIdGenerator } from "../../src/model/id.js";
+import { IdSource } from "../../src/model/objectTypeSchema.js";
+import { OrmModel } from "../../src/model/OrmModel.js";
+import { createSubtypeFact, type SubtypeFact } from "../../src/model/SubtypeFact.js";
+import {
+  decodeSubtypeFact,
+  decodeSubtypeFactConfig,
+  SubtypeFactError,
+  type SubtypeFactProblem,
+  type SubtypeFactProblems,
+} from "../../src/model/subtypeFactDecoder.js";
+import {
+  DeserializationError,
+  OrmYamlSerializer,
+} from "../../src/serialization/OrmYamlSerializer.js";
+
+afterEach(() => {
+  setIdGenerator(undefined);
+});
+
+function run(
+  decoded: Effect.Effect<SubtypeFact, SubtypeFactProblems, IdSource>,
+): Result.Result<SubtypeFact, readonly SubtypeFactProblem[]> {
+  let n = 0;
+  return Effect.runSync(
+    decoded.pipe(
+      Effect.mapError((e) => e.problems),
+      Effect.result,
+      Effect.provideService(IdSource, { newId: () => `minted-${++n}` }),
+    ),
+  );
+}
+
+function problems(decoded: Effect.Effect<SubtypeFact, SubtypeFactProblems, IdSource>) {
+  const result = run(decoded);
+  if (Result.isSuccess(result)) throw new Error("expected the decode to fail");
+  return result.failure;
+}
+
+describe("the subtype fact record", () => {
+  it("is a frozen plain record with every default applied and no derived name", () => {
+    const sf = createSubtypeFact({ subtypeId: "sub", supertypeId: "super" });
+    expect(Object.getPrototypeOf(sf)).toBe(Object.prototype);
+    expect(Object.isFrozen(sf)).toBe(true);
+    expect(Object.keys(sf).sort()).toEqual([
+      "id",
+      "isExclusive",
+      "isExhaustive",
+      "providesIdentification",
+      "subtypeId",
+      "supertypeId",
+    ]);
+    expect(sf).toMatchObject({ providesIdentification: true, isExclusive: false });
+  });
+
+  it("leaves an absent defining rule absent, not undefined, even when a config says undefined", () => {
+    const sf = createSubtypeFact({
+      subtypeId: "sub",
+      supertypeId: "super",
+      definingRule: undefined,
+    });
+    expect("definingRule" in sf).toBe(false);
+  });
+
+  it("freezes a defining rule with the record", () => {
+    const sf = createSubtypeFact({
+      subtypeId: "sub",
+      supertypeId: "super",
+      definingRule: { kind: "derived", expression: "each Employee is paid" },
+    });
+    expect(Object.isFrozen(sf.definingRule)).toBe(true);
+  });
+
+  it("decodes a file's entry into the same record a config gives", () => {
+    const fromFile = run(decodeSubtypeFact({
+      id: "sf-1",
+      subtype: "sub",
+      supertype: "super",
+      is_exclusive: true,
+      defining_rule: { kind: "semiderived", expression: "x", is_formal: true },
+    }));
+    const fromConfig = run(decodeSubtypeFactConfig({
+      id: "sf-1",
+      subtypeId: "sub",
+      supertypeId: "super",
+      isExclusive: true,
+      definingRule: { kind: "semiderived", expression: "x", isFormal: true },
+    }));
+    expect(Result.isSuccess(fromFile) && fromFile.success).toEqual(
+      Result.isSuccess(fromConfig) && fromConfig.success,
+    );
+  });
+
+  it("mints a missing id from IdSource and from nothing else", () => {
+    setIdGenerator(() => "from-the-installed-generator");
+    const result = run(decodeSubtypeFactConfig({ subtypeId: "sub", supertypeId: "super" }));
+    expect(Result.isSuccess(result) && result.success.id).toBe("minted-1");
+  });
+});
+
+describe("refusals", () => {
+  it("reports every field problem at once, each at its field", () => {
+    const found = problems(decodeSubtypeFactConfig({
+      id: "sf-1",
+      subtypeId: "",
+      supertypeId: "b",
+      isExclusive: "yes",
+      colour: "red",
+    }));
+    expect(found.map((p) => p.field).sort()).toEqual(["colour", "isExclusive", "subtypeId"]);
+    expect(found.every((p) => p.message.startsWith('Subtype fact "sf-1" '))).toBe(true);
+  });
+
+  it("refuses a subtype fact from an entity to itself, at no one field", () => {
+    // A check across two fields, so Effect runs it once the fields decode:
+    // it is reported with the field problems when there are none.
+    const found = problems(decodeSubtypeFactConfig({ subtypeId: "a", supertypeId: "a" }));
+    expect(found).toEqual([{
+      subtypeFact: "",
+      field: "",
+      message:
+        'Subtype fact from "a" to "a" cannot have the same entity as both subtype and supertype.',
+    }]);
+  });
+
+  it("names a file's problems in the file's spelling", () => {
+    const found = problems(decodeSubtypeFact({
+      id: "sf-1",
+      subtype: "",
+      supertype: "b",
+      defining_rule: { kind: "guessed", expression: "x" },
+    }));
+    expect(found.map((p) => p.field).sort()).toEqual(["defining_rule", "subtype"]);
+  });
+
+  it("is thrown by createSubtypeFact as one SubtypeFactError carrying every problem", () => {
+    let caught: unknown;
+    try {
+      createSubtypeFact({ subtypeId: "", supertypeId: "a", isExhaustive: 1 as never });
+    } catch (e) {
+      caught = e;
+    }
+    expect(caught).toBeInstanceOf(SubtypeFactError);
+    expect((caught as SubtypeFactError).problems).toHaveLength(2);
+  });
+
+  it("refuses a malformed config even when a lenient caller skips the reference checks", () => {
+    const model = new OrmModel({ name: "M" });
+    expect(() =>
+      model.addSubtypeFact({ subtypeId: "x", supertypeId: "x" }, { skipPlayerValidation: true })
+    ).toThrow(SubtypeFactError);
+  });
+});
+
+describe("a subtype fact in code and the same subtype fact in a file", () => {
+  // Entities `a` and `b`, value type `v`: enough to reach every reference
+  // refusal addSubtypeFact makes as well as every refusal the schema makes.
+  const objectTypes = [
+    { id: "a", name: "A", kind: "entity" as const, reference_mode: "a_id" },
+    { id: "b", name: "B", kind: "entity" as const, reference_mode: "b_id" },
+    { id: "v", name: "V", kind: "value" as const },
+  ];
+
+  function codeRefuses(config: Record<string, unknown>): boolean {
+    const model = new OrmModel({ name: "M" });
+    model.addObjectType({ id: "a", name: "A", kind: "entity", referenceMode: "a_id" });
+    model.addObjectType({ id: "b", name: "B", kind: "entity", referenceMode: "b_id" });
+    model.addObjectType({ id: "v", name: "V", kind: "value" });
+    try {
+      model.addSubtypeFact(config as never);
+      return false;
+    } catch {
+      return true;
+    }
+  }
+
+  const serializer = new OrmYamlSerializer();
+
+  function fileRefuses(entry: Record<string, unknown>): boolean {
+    const yaml = stringify({
+      orm_version: "2.0",
+      model: { name: "M", object_types: objectTypes, subtype_facts: [entry] },
+    });
+    try {
+      serializer.deserialize(yaml);
+      return false;
+    } catch {
+      return true;
+    }
+  }
+
+  const end = fc.constantFrom("a", "b", "v", "missing", "");
+  const flag = fc.option(fc.constantFrom<unknown>(true, false, "yes"), { nil: undefined });
+  const rule = fc.option(
+    fc.record({
+      kind: fc.constantFrom("derived", "semiderived", "guessed"),
+      expression: fc.constantFrom("x", 3),
+      isFormal: fc.option(fc.constantFrom<unknown>(true, false, "no"), { nil: undefined }),
+    }),
+    { nil: undefined },
+  );
+  const candidate = fc.record({
+    id: fc.constantFrom("sf-1", ""),
+    subtypeId: end,
+    supertypeId: end,
+    providesIdentification: flag,
+    isExclusive: flag,
+    isExhaustive: flag,
+    definingRule: rule,
+    colour: fc.option(fc.constant("red"), { nil: undefined }),
+  });
+
+  function present(o: Record<string, unknown>): Record<string, unknown> {
+    return Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined));
+  }
+
+  function inFileSpelling(config: Record<string, unknown>): Record<string, unknown> {
+    const rule = config.definingRule as Record<string, unknown> | undefined;
+    return present({
+      id: config.id,
+      subtype: config.subtypeId,
+      supertype: config.supertypeId,
+      provides_identification: config.providesIdentification,
+      is_exclusive: config.isExclusive,
+      is_exhaustive: config.isExhaustive,
+      defining_rule: rule === undefined
+        ? undefined
+        : present({ kind: rule.kind, expression: rule.expression, is_formal: rule.isFormal }),
+      colour: config.colour,
+    });
+  }
+
+  it("are refused together or not at all", () => {
+    fc.assert(
+      fc.property(candidate, (raw) => {
+        const config = present(raw);
+        if (config.definingRule !== undefined) {
+          config.definingRule = present(config.definingRule as Record<string, unknown>);
+        }
+        expect(codeRefuses(config)).toBe(fileRefuses(inFileSpelling(config)));
+      }),
+      { numRuns: 300 },
+    );
+  });
+});
+
+describe("OrmYamlSerializer.deserialize", () => {
+  it("reports subtype fact problems beside schema errors elsewhere in the file", () => {
+    let errors: readonly { path: string; message: string; }[] = [];
+    try {
+      new OrmYamlSerializer().deserialize(`
+orm_version: "2.0"
+model:
+  name: M
+  object_types:
+    - id: a
+      name: A
+      kind: entity
+      reference_mode: a_id
+  subtype_facts:
+    - id: sf-1
+      subtype: a
+      supertype: a
+  fact_types:
+    - id: ft-1
+`);
+    } catch (e) {
+      expect(e).toBeInstanceOf(DeserializationError);
+      errors = (e as DeserializationError).validationResult!.errors;
+    }
+    expect(errors.map((e) => e.path)).toContain("/model/subtype_facts/0");
+    expect(errors.some((e) => e.message.includes("same entity"))).toBe(true);
+    expect(errors.some((e) => e.path.startsWith("/model/fact_types/0"))).toBe(true);
+  });
+});
diff --git a/barwise/packages/core/tests/model/subtypeFactSchemaDrift.test.ts b/barwise/packages/core/tests/model/subtypeFactSchemaDrift.test.ts
new file mode 100644
index 00000000..66dcbb23
--- /dev/null
+++ b/barwise/packages/core/tests/model/subtypeFactSchemaDrift.test.ts
@@ -0,0 +1,107 @@
+/**
+ * The JSON Schema's `subtype_fact` against the decoder's schema, as
+ * `objectTypeSchemaDrift.test.ts` compares the object type: both reduced to
+ * the facts a file is held to (which fields it may and must carry, and each
+ * field's type and enum, the defining rule's included), with the differences
+ * required to be exactly the ones listed below.
+ *
+ * Not compared, as there: `description`, `minLength` (the decoder states it
+ * as a check, pinned by the decoder's tests), `additionalProperties` (a parse
+ * option there, not the schema), and `default` (the decoder applies the
+ * defaults; `serializeSubtypeFact` omits them).
+ */
+import * as Schema from "effect/Schema";
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { SubtypeFactYamlCodec } from "../../src/model/subtypeFactSchema.js";
+
+type Node = Record<string, unknown> | boolean;
+
+const fileSchema = JSON.parse(
+  readFileSync(new URL("../../schemas/orm-model.schema.json", import.meta.url), "utf8"),
+) as { definitions: Record<string, Record<string, unknown>>; };
+
+/** The comparable facts of one schema node. */
+function facts(node: Node, defs: Record<string, Record<string, unknown>>): unknown {
+  if (node === false) return "forbidden";
+  if (node === true) return "anything";
+  if (typeof node.$ref === "string") {
+    return facts(defs[node.$ref.replace(/^#\/(definitions|\$defs)\//, "")]!, defs);
+  }
+  const alternatives = (node.anyOf ?? node.oneOf) as Node[] | undefined;
+  if (alternatives && node.type === undefined) {
+    return { anyOf: alternatives.map((a) => facts(a, defs)).sort(byJson) };
+  }
+  if (node.type === "object") {
+    const properties = (node.properties ?? {}) as Record<string, Node>;
+    return {
+      type: "object",
+      properties: Object.fromEntries(
+        Object.keys(properties).sort().map((k) => [k, facts(properties[k]!, defs)]),
+      ),
+      required: [...((node.required ?? []) as string[])].sort(),
+    };
+  }
+  const out: Record<string, unknown> = { type: node.type };
+  const values = node.enum ?? (node.const !== undefined ? [node.const] : undefined);
+  if (values !== undefined) out.enum = [...(values as unknown[])].sort();
+  return out;
+}
+
+const byJson = (a: unknown, b: unknown) => JSON.stringify(a).localeCompare(JSON.stringify(b));
+
+function fileFacts() {
+  return facts(fileSchema.definitions.subtype_fact!, fileSchema.definitions);
+}
+
+function decoderFacts() {
+  const doc = Schema.toJsonSchemaDocument(SubtypeFactYamlCodec);
+  const defs = (doc.definitions ?? {}) as Record<string, Record<string, unknown>>;
+  return facts(doc.schema as Node, defs);
+}
+
+/** Every path at which two fact trees differ. */
+function differences(a: unknown, b: unknown, path: string): string[] {
+  if (JSON.stringify(a) === JSON.stringify(b)) return [];
+  const isObject = (v: unknown) => v !== null && typeof v === "object" && !Array.isArray(v);
+  if (!isObject(a) || !isObject(b)) return [path];
+  const keys = new Set([...Object.keys(a as object), ...Object.keys(b as object)]);
+  return [...keys].sort().flatMap((k) =>
+    differences(
+      (a as Record<string, unknown>)[k],
+      (b as Record<string, unknown>)[k],
+      `${path}.${k}`,
+    )
+  );
+}
+
+/**
+ * Where the two are meant to differ. Each entry must still be a difference:
+ * one that closes fails the test until it is removed here.
+ */
+const KNOWN: Record<string, string> = {
+  "subtype_fact.required":
+    "a file must carry an id; the decoder mints a missing one from IdSource, and the loader keeps the schema's refusal",
+};
+
+describe("the JSON Schema's subtype_fact and the decoder's", () => {
+  it("hold a subtype fact to the same facts, but for the known differences", () => {
+    const found = differences(fileFacts(), decoderFacts(), "subtype_fact");
+    expect(found.sort()).toEqual(Object.keys(KNOWN).sort());
+  });
+
+  it("sees a derivation kind dropped from the file schema", () => {
+    const rule = fileSchema.definitions.derivation_rule_def as {
+      properties: { kind: { enum: string[]; }; };
+    };
+    const original = rule.properties.kind.enum;
+    rule.properties.kind.enum = original.filter((k) => k !== "semiderived");
+    try {
+      expect(differences(fileFacts(), decoderFacts(), "subtype_fact")).toContain(
+        "subtype_fact.properties.defining_rule.properties.kind.enum",
+      );
+    } finally {
+      rule.properties.kind.enum = original;
+    }
+  });
+});
