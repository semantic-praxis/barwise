index 00000000..8eaea755
--- /dev/null
+++ b/barwise/packages/core/src/model/schemaProblems.ts
@@ -0,0 +1,193 @@
+/**
+ * Effect's issue tree as one problem per entry, for the element decoders
+ * (`objectTypeDecoder.ts`, `subtypeFactDecoder.ts`).
+ *
+ * Each decoder states its own subject -- what a message calls the element --
+ * and its own YAML spelling; walking the tree, locating each failure in the
+ * input's spelling and phrasing Effect's structural refusals is the same for
+ * every element kind, so it lives once, here.
+ */
+import type * as SchemaAST from "effect/SchemaAST";
+import * as SchemaIssue from "effect/SchemaIssue";
+
+/** The decode options every element decoder runs with. */
+export const PARSE_OPTIONS: SchemaAST.ParseOptions = { errors: "all", onExcessProperty: "error" };
+
+/** One thing wrong with one element. */
+export interface ElementProblem {
+  /** What identifies the element in the input: its name, its id, or "" when it has neither. */
+  readonly identity: string;
+  /** The top-level field at fault, in the spelling of the input. */
+  readonly field: string;
+  /** A sentence naming the element and the field. */
+  readonly message: string;
+}
+
+/** What a message calls the element, and how a problem identifies it. */
+export interface ProblemSubject {
+  readonly label: string;
+  readonly identity: string;
+}
+
+export interface ProblemOptions {
+  /** The subject every message opens with. */
+  readonly subject: ProblemSubject;
+  /** The file spelling of every decoded key that is not spelled the same. */
+  readonly fileSpelling: Readonly<Record<string, string>>;
+  /** The field a problem with no path is reported at. */
+  readonly rootField: string;
+  /** The predicate for a root union none of whose members applied. */
+  readonly rootUnion?: string;
+}
+
+/** One failure in the issue tree, with the path that leads to it. */
+interface Located {
+  readonly path: readonly PropertyKey[];
+  readonly issue: SchemaIssue.Issue;
+}
+
+/**
+ * The failures in an issue tree, one per problem.
+ *
+ * A union is descended only when one member was tried: that is a
+ * discriminated union picking its variant, and the problems are that
+ * variant's. A union none of whose members applied, or several, is one
+ * problem at its own position -- `max: "lots"` is one bad value, not one per
+ * member it failed to match.
+ */
+function locate(issue: SchemaIssue.Issue, path: readonly PropertyKey[]): Located[] {
+  switch (issue._tag) {
+    case "Pointer":
+      return locate(issue.issue, [...path, ...issue.path]);
+    case "Composite":
+      return issue.issues.flatMap((child) => locate(child, path));
+    case "Encoding":
+      return locate(issue.issue, path);
+    case "AnyOf":
+      return issue.issues.length === 1 ? locate(issue.issues[0]!, path) : [{ path, issue }];
+    default:
+      return [{ path, issue }];
+  }
+}
+
+/** Every problem in an issue tree, each a sentence about the subject. */
+export function problemsOf(
+  issue: SchemaIssue.Issue,
+  raw: unknown,
+  options: ProblemOptions,
+): [ElementProblem, ...ElementProblem[]] {
+  const { subject } = options;
+  const problems = locate(issue, []).map(({ path: decodedPath, issue: leaf }) => {
+    const path = spelledAs(raw, decodedPath, options.fileSpelling);
+    const field = path.length > 0 ? String(path[0]) : options.rootField;
+    return {
+      identity: subject.identity,
+      field,
+      message: `${subject.label} ${predicateOf(leaf, path, options.rootUnion)}`,
+    };
+  });
+  // A decode that failed always carries at least one leaf; the fallback only
+  // keeps the type honest if Effect ever hands back an empty composite.
+  return problems.length > 0
+    ? (problems as [ElementProblem, ...ElementProblem[]])
+    : [{ identity: subject.identity, field: "", message: `${subject.label} is malformed.` }];
+}
+
+/**
+ * A path in the spelling of the input it points into.
+ *
+ * Effect reports a check on a decoded struct at the decoded key, so a file's
+ * empty value constraint comes back at `valueConstraint` -- a key the file
+ * does not have. Each segment the input lacks is replaced by its file
+ * spelling when the input has that instead; an unknown key the input does
+ * have, even a camelCase one, is left as written.
+ */
+function spelledAs(
+  raw: unknown,
+  path: readonly PropertyKey[],
+  fileSpelling: Readonly<Record<string, string>>,
+): PropertyKey[] {
+  const spelled: PropertyKey[] = [];
+  let node = raw;
+  for (const segment of path) {
+    let key = segment;
+    if (node !== null && typeof node === "object") {
+      const record = node as Record<PropertyKey, unknown>;
+      if (typeof segment === "string" && !(segment in record)) {
+        const fileKey = fileSpelling[segment];
+        if (fileKey !== undefined && fileKey in record) key = fileKey;
+      }
+      node = record[key];
+    } else {
+      node = undefined;
+    }
+    spelled.push(key);
+  }
+  return spelled;
+}
+
+const defaultFormat = SchemaIssue.makeFormatterDefault();
+
+/**
+ * The rest of the sentence after the subject.
+ *
+ * Every rule a schema states carries its own predicate as a `message`
+ * annotation; those are used as they are. What is left is Effect's own
+ * structural refusals -- a wrong type, a missing key, an unknown key -- which
+ * are phrased here around the path, because Effect's text names neither the
+ * element nor, for a key, the field.
+ */
+function predicateOf(
+  issue: SchemaIssue.Issue,
+  path: readonly PropertyKey[],
+  rootUnion: string | undefined,
+): string {
+  const at = path.map(String).join(".");
+  switch (issue._tag) {
+    case "UnexpectedKey":
+      return `has an unknown field "${at}".`;
+    case "MissingKey":
+      return issue.annotations?.messageMissingKey ?? `is missing "${at}".`;
+    case "AnyOf": {
+      if (path.length === 0 && rootUnion !== undefined) return rootUnion;
+      const message = issue.ast.annotations?.message;
+      if (typeof message === "string") return message;
+      break;
+    }
+    case "Filter": {
+      const message = issue.filter.annotations?.message;
+      if (typeof message === "string") return message;
+      break;
+    }
+    case "InvalidType":
+    case "InvalidValue": {
+      const message = issue._tag === "InvalidType"
+        ? issue.ast.annotations?.message
+        : issue.annotations?.message;
+      if (typeof message === "string") return message;
+      break;
+    }
+  }
+  return `has an invalid ${at}: ${defaultFormat(issue)}.`;
+}
+
+/**
+ * A copy with every `undefined`-valued key removed, at any depth.
+ *
+ * A config key holding `undefined` is treated as absent, because that is what
+ * it has always meant to a caller: configs are routinely built as
+ * `{ referenceMode: other.referenceMode, ... }`, and a schema's optional keys
+ * refuse an explicit `undefined`.
+ */
+export function withoutUndefined(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(withoutUndefined);
+  if (value === null || typeof value !== "object") return value;
+  if (Object.getPrototypeOf(value) !== Object.prototype && Object.getPrototypeOf(value) !== null) {
+    return value;
+  }
+  return Object.fromEntries(
+    Object.entries(value)
+      .filter(([, v]) => v !== undefined)
+      .map(([k, v]) => [k, withoutUndefined(v)]),
+  );
+}
