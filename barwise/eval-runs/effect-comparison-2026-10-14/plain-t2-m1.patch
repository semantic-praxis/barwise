@@ -0,0 +1,135 @@
+import {
+  buildSubtypeFact,
+  type FieldSpelling,
+  identifySubtypeFact,
+  type SubtypeFactConfig,
+  type SubtypeFactDecodeResult,
+  type SubtypeFactProblem,
+  subtypeFactRuleProblems,
+} from "../../model/SubtypeFact.js";
+
+/**
+ * Every config field and its YAML spelling: the one statement of which
+ * fields a subtype fact has in a file.
+ *
+ * `satisfies` makes the compiler check it against `SubtypeFactConfig` both
+ * ways, and `tests/serialization/decodeSubtypeFact.test.ts` checks the YAML
+ * names against the JSON Schema's `subtype_fact` properties. The decoder
+ * refuses a key not listed here, which is the schema's
+ * `additionalProperties: false`.
+ */
+export const SUBTYPE_FACT_YAML_FIELDS = {
+  id: "id",
+  subtypeId: "subtype",
+  supertypeId: "supertype",
+  providesIdentification: "provides_identification",
+  isExclusive: "is_exclusive",
+  isExhaustive: "is_exhaustive",
+  definingRule: "defining_rule",
+} as const satisfies Record<keyof SubtypeFactConfig, string>;
+
+/** The defining rule's fields, YAML spelling to config spelling. */
+const DERIVATION_YAML_FIELDS: Readonly<Record<string, string>> = {
+  kind: "kind",
+  storage: "storage",
+  expression: "expression",
+  is_formal: "isFormal",
+};
+
+type Field = keyof SubtypeFactConfig;
+type Doc = Readonly<Record<string, unknown>>;
+
+const CONFIG_FIELD: ReadonlyMap<string, Field> = new Map(
+  Object.entries(SUBTYPE_FACT_YAML_FIELDS).map(([field, yaml]) => [yaml, field as Field]),
+);
+
+const snake = (s: string) => s.replace(/[A-Z]/g, (c) => `_${c.toLowerCase()}`);
+
+/** A config path in YAML spelling: `definingRule.isFormal` -> `defining_rule.is_formal`. */
+const yamlSpelling: FieldSpelling = (path) => {
+  const [head, ...rest] = path.split(".");
+  return [SUBTYPE_FACT_YAML_FIELDS[head as Field] ?? head!, ...rest.map(snake)].join(".");
+};
+
+function isRecord(v: unknown): v is Doc {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+/**
+ * Turn one parsed YAML subtype fact into a `SubtypeFact`, or into every
+ * problem with it.
+ *
+ * The decoder's own work is what only a file can carry: a key the format
+ * does not know, at the top level or inside the defining rule. Everything
+ * else -- every type, enum and emptiness check the JSON Schema's
+ * `subtype_fact` definition states, and the self-subtyping rule it cannot
+ * -- is `subtypeFactRuleProblems`, the rules `createSubtypeFact` applies
+ * to a config built in code, so the two refuse the same subtype facts in
+ * the same words, each in its own spelling of the field.
+ *
+ * Values are passed through as written, `null` included, so a `null` is
+ * refused as the wrong type rather than read as absent.
+ *
+ * `newId` is the only source of a fresh id, called once, and only for an
+ * entry with no `id` that decodes cleanly.
+ */
+export function decodeSubtypeFact(doc: unknown, newId: () => string): SubtypeFactDecodeResult {
+  if (!isRecord(doc)) {
+    return {
+      ok: false,
+      problems: [{
+        subtypeFact: "",
+        field: "",
+        message: `A subtype fact must be a mapping of fields, not ${shown(doc)}.`,
+      }],
+    };
+  }
+
+  const { subtypeFact, subject } = identifySubtypeFact(doc.id, doc.subtype, doc.supertype);
+  const problems: SubtypeFactProblem[] = [];
+  const config: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(doc)) {
+    const field = CONFIG_FIELD.get(key);
+    if (field === undefined) {
+      problems.push({
+        subtypeFact,
+        field: key,
+        message: `${subject} has an unknown field \`${key}\`.`,
+      });
+    } else if (field === "definingRule" && isRecord(value)) {
+      const rule: Record<string, unknown> = {};
+      for (const [ruleKey, ruleValue] of Object.entries(value)) {
+        const ruleField = DERIVATION_YAML_FIELDS[ruleKey];
+        if (ruleField === undefined) {
+          problems.push({
+            subtypeFact,
+            field: key,
+            message: `${subject}: \`${key}.${ruleKey}\` is not a derivation rule field.`,
+          });
+        } else {
+          rule[ruleField] = ruleValue;
+        }
+      }
+      config[field] = rule;
+    } else {
+      config[field] = value;
+    }
+  }
+
+  const checked = config as unknown as SubtypeFactConfig;
+  for (const p of subtypeFactRuleProblems(checked, yamlSpelling)) {
+    problems.push({ ...p, field: SUBTYPE_FACT_YAML_FIELDS[p.field as Field] });
+  }
+  if (problems.length > 0) return { ok: false, problems };
+  return { ok: true, value: buildSubtypeFact(checked, newId) };
+}
+
+/** How a wrong value reads in a message: what the reader wrote, briefly. */
+function shown(v: unknown): string {
+  if (v === null) return "null";
+  if (Array.isArray(v)) return "a list";
+  if (typeof v === "object") return "a mapping";
+  if (typeof v === "string") return JSON.stringify(v);
+  return String(v);
+}
