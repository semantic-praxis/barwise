--- /dev/null
+++ b/barwise/packages/core/tests/serialization/decodeSubtypeFact.test.ts
@@ -0,0 +1,379 @@
+/**
+ * The subtype fact decoder, and the claim the sealed record rests on: a
+ * subtype fact built in code is refused exactly when the same subtype fact
+ * in a file is.
+ *
+ * As for `decodeObjectType`, the decoder restates what the JSON Schema's
+ * `subtype_fact` definition says, so the first two blocks are its drift
+ * test: the field table against the schema's property names, and the
+ * decoder's verdict against the schema's over a corpus that varies every
+ * field. The third block is the parity between the two entry points,
+ * through `createSubtypeFact` and `decodeSubtypeFact` and again through
+ * `OrmModel.addSubtypeFact` and `OrmYamlSerializer.deserialize`.
+ */
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { parse } from "yaml";
+import { OrmModel } from "../../src/model/OrmModel.js";
+import {
+  createSubtypeFact,
+  type SubtypeFactConfig,
+  SubtypeFactError,
+} from "../../src/model/SubtypeFact.js";
+import {
+  DeserializationError,
+  OrmYamlSerializer,
+} from "../../src/serialization/OrmYamlSerializer.js";
+import { SchemaValidator } from "../../src/serialization/SchemaValidator.js";
+import {
+  decodeSubtypeFact,
+  SUBTYPE_FACT_YAML_FIELDS,
+} from "../../src/serialization/yaml/decodeSubtypeFact.js";
+import { serializeSubtypeFact } from "../../src/serialization/yaml/subtype.js";
+
+const schema = JSON.parse(
+  readFileSync(new URL("../../schemas/orm-model.schema.json", import.meta.url), "utf8"),
+) as { definitions: { subtype_fact: { properties: Record<string, unknown>; }; }; };
+
+const never = () => {
+  throw new Error("the decoder asked for an id it did not need");
+};
+
+type Doc = Record<string, unknown>;
+
+/** A subtype fact carrying every field, so every field is varied. */
+const FULL: Doc = {
+  id: "sf-1",
+  subtype: "ot-sub",
+  supertype: "ot-super",
+  provides_identification: false,
+  is_exclusive: true,
+  is_exhaustive: true,
+  defining_rule: {
+    kind: "semiderived",
+    storage: "derived_and_stored",
+    expression: "each Person who is employed",
+    is_formal: true,
+  },
+};
+
+/** Values every field is tried with, right and wrong for most of them. */
+const ANY: unknown[] = [undefined, null, "", "  ", "x", 0, 1.5, true, false, [], ["a"], {}];
+
+/** Values worth trying only in one field. */
+const SPECIFIC: Record<string, unknown[]> = {
+  subtype: ["ot-super"],
+  supertype: ["ot-sub"],
+  defining_rule: [
+    { kind: "derived", expression: "" },
+    { kind: "derived" },
+    { expression: "x" },
+    { kind: "other", expression: "x" },
+    { kind: "derived", expression: 3 },
+    { kind: "derived", expression: "x", storage: "derive_on_request" },
+    { kind: "derived", expression: "x", storage: "sometimes" },
+    { kind: "derived", expression: "x", is_formal: true },
+    { kind: "derived", expression: "x", is_formal: "yes" },
+    { kind: "derived", expression: "x", colour: 1 },
+  ],
+};
+
+/**
+ * The one rule only the decoder states, because JSON Schema cannot compare
+ * two fields. Listed so the corpus can say "the schema accepts this and the
+ * decoder must not", and so its moving into the schema is noticed.
+ */
+function decoderOnly(doc: Doc): string | undefined {
+  if (typeof doc.subtype === "string" && doc.subtype !== "" && doc.subtype === doc.supertype) {
+    return "a subtype fact whose two ends are one entity";
+  }
+  return undefined;
+}
+
+function corpus(): { label: string; doc: Doc; }[] {
+  const cases: { label: string; doc: Doc; }[] = [{ label: "as given", doc: FULL }];
+  for (const field of [...Object.keys(schema.definitions.subtype_fact.properties), "colour"]) {
+    for (const v of [...ANY, ...(SPECIFIC[field] ?? [])]) {
+      // A missing id is the one place the two differ by design: the decoder
+      // mints one, a file must name it. The loader tests below cover it.
+      if (field === "id" && v === undefined) continue;
+      const doc = { ...FULL };
+      if (v === undefined) delete doc[field];
+      else doc[field] = v;
+      cases.push({ label: `with ${field} = ${JSON.stringify(v)}`, doc });
+    }
+  }
+  return cases;
+}
+
+const validator = new SchemaValidator();
+const schemaAccepts = (doc: Doc) =>
+  validator.validateModel({ orm_version: "2.0", model: { name: "T", subtype_facts: [doc] } })
+    .valid;
+
+describe("decodeSubtypeFact agrees with the JSON Schema", () => {
+  it("knows exactly the schema's subtype fact fields", () => {
+    expect(Object.values(SUBTYPE_FACT_YAML_FIELDS).sort()).toEqual(
+      Object.keys(schema.definitions.subtype_fact.properties).sort(),
+    );
+  });
+
+  const cases = corpus();
+
+  it("the corpus exercises both verdicts and the decoder-only rule", () => {
+    const verdicts = cases.map((c) => decodeSubtypeFact(c.doc, never).ok);
+    expect(verdicts).toContain(true);
+    expect(verdicts).toContain(false);
+    expect(cases.some((c) => decoderOnly(c.doc) !== undefined)).toBe(true);
+  });
+
+  it.each(cases)("$label", ({ doc }) => {
+    const decoded = decodeSubtypeFact(doc, never);
+    if (decoderOnly(doc) !== undefined) {
+      expect(decoded.ok).toBe(false);
+    } else {
+      expect(decoded.ok).toBe(schemaAccepts(doc));
+    }
+  });
+});
+
+describe("decodeSubtypeFact", () => {
+  it("decodes what the serializer writes back to the same subtype fact", () => {
+    const first = decodeSubtypeFact(FULL, never);
+    expect(first.ok).toBe(true);
+    if (!first.ok) return;
+    expect(decodeSubtypeFact(serializeSubtypeFact(first.value), never)).toEqual(first);
+  });
+
+  it("applies the defaults once and leaves an absent rule absent", () => {
+    const result = decodeSubtypeFact({ id: "sf", subtype: "a", supertype: "b" }, never);
+    expect(result).toEqual({
+      ok: true,
+      value: {
+        id: "sf",
+        subtypeId: "a",
+        supertypeId: "b",
+        providesIdentification: true,
+        isExclusive: false,
+        isExhaustive: false,
+      },
+    });
+    if (result.ok) expect("definingRule" in result.value).toBe(false);
+  });
+
+  it("reports every problem in one pass, each naming the subtype fact and the field", () => {
+    const result = decodeSubtypeFact({
+      id: "sf-9",
+      subtype: "a",
+      supertype: "a",
+      is_exclusive: "yes",
+      defining_rule: { kind: "other", expression: "x" },
+      colour: "red",
+    }, never);
+    expect(result.ok).toBe(false);
+    if (result.ok) return;
+    expect(result.problems.map((p) => p.field).sort()).toEqual([
+      "colour",
+      "defining_rule",
+      "is_exclusive",
+      "supertype",
+    ]);
+    for (const p of result.problems) {
+      expect(p.subtypeFact).toBe("sf-9");
+      expect(p.message).toContain('"sf-9"');
+    }
+  });
+
+  it("refuses an entry that is not a mapping", () => {
+    expect(decodeSubtypeFact("Employee", never)).toMatchObject({
+      ok: false,
+      problems: [{ field: "", message: expect.stringContaining('not "Employee"') }],
+    });
+  });
+
+  it("calls the id source once, for an entry with no id", () => {
+    let calls = 0;
+    const result = decodeSubtypeFact({ subtype: "a", supertype: "b" }, () => `m-${++calls}`);
+    expect(result).toMatchObject({ ok: true, value: { id: "m-1" } });
+    expect(calls).toBe(1);
+  });
+});
+
+/**
+ * Configs a typed caller can write, crossed over the values that matter to
+ * a rule: the id present, empty or absent; each end empty, an entity, the
+ * other entity, a value type, or missing from the model; and the flags and
+ * defining rule present or not.
+ */
+function configCorpus(ids: { a: string; b: string; v: string; }): SubtypeFactConfig[] {
+  const configs: SubtypeFactConfig[] = [];
+  const ends = ["", ids.a, ids.b, ids.v, "ot-missing"];
+  for (const id of [undefined, "", "sf-x"]) {
+    for (const subtypeId of ends) {
+      for (const supertypeId of ends) {
+        configs.push({ ...(id !== undefined ? { id } : {}), subtypeId, supertypeId });
+      }
+    }
+  }
+  configs.push({
+    id: "sf-flags",
+    subtypeId: ids.a,
+    supertypeId: ids.b,
+    providesIdentification: false,
+    isExclusive: true,
+    isExhaustive: true,
+    definingRule: { kind: "derived", storage: "derived_and_stored", expression: "" },
+  });
+  return configs;
+}
+
+/** The file entry for a config: each field in its YAML spelling, as given. */
+function asDoc(config: SubtypeFactConfig): Doc {
+  const doc: Doc = {};
+  for (const [field, yamlField] of Object.entries(SUBTYPE_FACT_YAML_FIELDS)) {
+    const v = config[field as keyof SubtypeFactConfig];
+    if (v === undefined) continue;
+    doc[yamlField] = field === "definingRule"
+      ? {
+        kind: config.definingRule!.kind,
+        expression: config.definingRule!.expression,
+        ...(config.definingRule!.storage ? { storage: config.definingRule!.storage } : {}),
+      }
+      : v;
+  }
+  return doc;
+}
+
+const refusalOf = (build: () => unknown): string[] | undefined => {
+  try {
+    build();
+    return undefined;
+  } catch (e) {
+    return e instanceof SubtypeFactError ? e.problems.map((p) => p.message) : [String(e)];
+  }
+};
+
+describe("a subtype fact built in code is refused exactly when the same one in a file is", () => {
+  const ids = { a: "ot-a", b: "ot-b", v: "ot-v" };
+
+  it.each(configCorpus(ids).map((config) => ({ label: JSON.stringify(config), config })))(
+    "record: $label",
+    ({ config }) => {
+      const fromCode = refusalOf(() => createSubtypeFact(config, () => "minted"));
+      const fromFile = decodeSubtypeFact(asDoc(config), () => "minted");
+      expect(fromFile.ok ? undefined : fromFile.problems.map((p) => p.message)).toEqual(
+        fromCode,
+      );
+    },
+  );
+
+  // The schema corpus again, read as configs: a cast or untyped JavaScript
+  // can hand code every wrong value a file can hold, so code must refuse
+  // each one the file refuses. Unknown keys are left out -- the one
+  // deliberate difference, covered in tests/model/SubtypeFact.test.ts.
+  const camel = (s: string) => s.replace(/_([a-z])/g, (_, c: string) => c.toUpperCase());
+  const asConfig = (doc: Doc): SubtypeFactConfig => {
+    const config: Doc = {};
+    for (const [field, yamlField] of Object.entries(SUBTYPE_FACT_YAML_FIELDS)) {
+      if (!(yamlField in doc)) continue;
+      const v = doc[yamlField];
+      config[field] = typeof v === "object" && v !== null && !Array.isArray(v)
+        ? Object.fromEntries(Object.entries(v).map(([k, x]) => [camel(k), x]))
+        : v;
+    }
+    return config as unknown as SubtypeFactConfig;
+  };
+  const knownKeysOnly = corpus().filter(({ doc }) =>
+    Object.keys(doc).every((k) => k in schema.definitions.subtype_fact.properties)
+    && !JSON.stringify(doc).includes("colour")
+  );
+
+  it.each(knownKeysOnly)("cast config: $label", ({ doc }) => {
+    const fromFile = decodeSubtypeFact(doc, () => "minted");
+    const fromCode = refusalOf(() => createSubtypeFact(asConfig(doc), () => "minted"));
+    expect(fromCode !== undefined).toBe(!fromFile.ok);
+    if (!fromFile.ok) expect(fromCode).toHaveLength(fromFile.problems.length);
+  });
+
+  it("keeps and freezes the defining rule, from code and from a file", () => {
+    const rule = { kind: "derived", storage: "derived_and_stored", expression: "x" } as const;
+    const fromCode = createSubtypeFact(
+      { subtypeId: "a", supertypeId: "b", definingRule: rule },
+      () => "m",
+    );
+    const fromFile = decodeSubtypeFact({
+      id: "m",
+      subtype: "a",
+      supertype: "b",
+      defining_rule: rule,
+    }, never);
+    expect(fromFile.ok).toBe(true);
+    for (const sf of [fromCode, fromFile.ok ? fromFile.value : undefined]) {
+      expect(sf!.definingRule).toEqual(rule);
+      expect(sf!.definingRule).not.toBe(rule);
+      expect(Object.isFrozen(sf!.definingRule)).toBe(true);
+    }
+  });
+
+  const serializer = new OrmYamlSerializer();
+
+  function baseModel(): OrmModel {
+    const model = new OrmModel({ name: "M" });
+    model.addObjectType({ id: ids.a, name: "A", kind: "entity", referenceMode: "a_id" });
+    model.addObjectType({ id: ids.b, name: "B", kind: "entity", referenceMode: "b_id" });
+    model.addObjectType({ id: ids.v, name: "V", kind: "value" });
+    // An existing A -> B, so a second one is a duplicate in both.
+    model.addSubtypeFact({ id: "sf-existing", subtypeId: ids.a, supertypeId: ids.b });
+    return model;
+  }
+
+  for (const lenient of [false, true]) {
+    // A file names every id; a config without one has it minted, so that
+    // difference is the id's and not the rules'. Each config is given one.
+    const configs = configCorpus(ids).map((c) => ("id" in c ? c : { ...c, id: "sf-minted" }));
+    it.each(configs.map((config) => ({ label: JSON.stringify(config), config })))(
+      `model${lenient ? " (lenient)" : ""}: $label`,
+      ({ config }) => {
+        const inCode = baseModel();
+        const codeRefused = refusalOf(() =>
+          inCode.addSubtypeFact(config, { skipPlayerValidation: lenient })
+        ) !== undefined;
+
+        const doc = parse(serializer.serialize(baseModel())) as {
+          model: { subtype_facts?: Doc[]; };
+        };
+        doc.model.subtype_facts = [...(doc.model.subtype_facts ?? []), asDoc(config)];
+        const fileRefused = refusalOf(() =>
+          serializer.deserialize(JSON.stringify(doc), { lenient })
+        ) !== undefined;
+
+        expect(fileRefused).toBe(codeRefused);
+      },
+    );
+  }
+
+  it("refuses a file's subtype fact with no id, naming its ends", () => {
+    let error: unknown;
+    try {
+      serializer.deserialize(
+        `orm_version: "2.0"
+model:
+  name: M
+  subtype_facts:
+    - subtype: a
+      supertype: b
+`,
+        { lenient: true },
+      );
+    } catch (e) {
+      error = e;
+    }
+    expect(error).toBeInstanceOf(DeserializationError);
+    expect((error as DeserializationError).validationResult!.errors).toEqual([
+      {
+        path: "/model/subtype_facts/0/id",
+        message: 'The subtype fact from "a" to "b" must have an id.',
+      },
+    ]);
+  });
+});
