+  decodeSubtypeFact,
+  DERIVATION_RULE_YAML_FIELDS,
+  SUBTYPE_FACT_YAML_FIELDS,
+} from "../../src/serialization/yaml/decodeSubtypeFact.js";
+import { serializeSubtypeFact } from "../../src/serialization/yaml/subtype.js";
+
+interface Definition {
+  properties: Record<string, unknown>;
