+ * as a sealed record).
+ *
+ * The decoder restates the JSON Schema's `subtype_fact` definition, so its
+ * field table is checked against the schema's properties and its verdict
+ * against the schema's over a corpus varying every field -- the drift test
+ * `decodeObjectType.test.ts` is for object types. The last block compares
+ * `OrmModel.addSubtypeFact` with a file load over the cases a typed config
+ * can express, referential ones included.
+ */
+import { readFileSync } from "node:fs";
+import { afterEach, describe, expect, it } from "vitest";
