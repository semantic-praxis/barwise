+  readFileSync(new URL("../../schemas/orm-model.schema.json", import.meta.url), "utf8"),
+) as { definitions: { subtype_fact: Definition; derivation_rule_def: Definition; }; };
+
+const never = () => {
+  throw new Error("the decoder asked for an id it did not need");
+};
+
+type Doc = Record<string, unknown>;
+
+/** A subtype fact carrying every field, so every field is varied. */
+const FULL: Doc = {
+  id: "sf-1",
+  subtype: "ot-adult",
+  supertype: "ot-person",
+  provides_identification: false,
+  is_exclusive: true,
+  is_exhaustive: true,
+  defining_rule: {
+    kind: "derived",
+    storage: "derived_and_stored",
+    expression: "each Adult is a Person aged 18 or over",
+    is_formal: true,
+  },
+};
+
+const ANY: unknown[] = [undefined, null, "", "  ", "x", 0, 1.5, true, false, [], ["a"], {}];
+
+const SPECIFIC: Record<string, unknown[]> = {
+  subtype: ["ot-person"],
+  supertype: ["ot-adult"],
+  defining_rule: [
+    { kind: "derived", expression: "" },
+    { kind: "semiderived", expression: "x" },
+    { kind: "asserted", expression: "x" },
+    { expression: "x" },
+    { kind: "derived" },
+    { kind: "derived", expression: 3 },
+    { kind: "derived", expression: "x", storage: "derive_on_request" },
+    { kind: "derived", expression: "x", storage: "cached" },
+    { kind: "derived", expression: "x", is_formal: false },
+    { kind: "derived", expression: "x", is_formal: "no" },
+    { kind: "derived", expression: "x", colour: 1 },
+    { kind: null, expression: "x" },
+    { kind: 3, expression: "x" },
+    { kind: "derived", expression: null },
+    { kind: "derived", expression: "x", storage: null },
+    { kind: "derived", expression: "x", storage: 1 },
+    { kind: "derived", expression: "x", is_formal: null },
+    { kind: "derived", expression: "x", is_formal: true },
+  ],
+};
+
+/** The one rule only the decoder states: JSON Schema cannot compare two fields. */
+function decoderOnly(doc: Doc): string | undefined {
+  if (typeof doc.subtype === "string" && doc.subtype !== "" && doc.subtype === doc.supertype) {
+    return "the same entity as both subtype and supertype";
+  }
+  return undefined;
+}
+
+function corpus(): { label: string; doc: Doc; }[] {
+  const cases: { label: string; doc: Doc; }[] = [{ label: "as given", doc: FULL }];
+  for (const field of [...Object.keys(schema.definitions.subtype_fact.properties), "colour"]) {
+    for (const v of [...ANY, ...(SPECIFIC[field] ?? [])]) {
+      // A missing id is where the two differ by design: the decoder mints
+      // one, a file must name it. The loader tests below cover it.
+      if (field === "id" && v === undefined) continue;
+      const doc = { ...FULL };
+      if (v === undefined) delete doc[field];
+      else doc[field] = v;
+      cases.push({ label: `${field} = ${JSON.stringify(v)}`, doc });
+    }
+  }
+  return cases;
+}
+
+const validator = new SchemaValidator();
+const schemaAccepts = (doc: Doc) =>
+  validator.validateModel({ orm_version: "2.0", model: { name: "T", subtype_facts: [doc] } })
+    .valid;
+
+describe("decodeSubtypeFact agrees with the JSON Schema", () => {
+  it("knows exactly the schema's subtype fact fields", () => {
+    expect(Object.values(SUBTYPE_FACT_YAML_FIELDS).sort()).toEqual(
+      Object.keys(schema.definitions.subtype_fact.properties).sort(),
+    );
+  });
+
+  it("knows exactly the schema's defining rule fields", () => {
+    expect(Object.values(DERIVATION_RULE_YAML_FIELDS).sort()).toEqual(
+      Object.keys(schema.definitions.derivation_rule_def.properties).sort(),
+    );
+  });
+
+  const cases = corpus();
+
+  it("the corpus exercises both verdicts and the decoder-only rule", () => {
+    const verdicts = cases.map((c) => decodeSubtypeFact(c.doc, never).ok);
+    expect(verdicts).toContain(true);
+    expect(verdicts).toContain(false);
+    expect(cases.some((c) => decoderOnly(c.doc) !== undefined)).toBe(true);
+  });
+
+  it.each(cases)("$label", ({ doc }) => {
+    const decoded = decodeSubtypeFact(doc, never);
+    if (decoderOnly(doc) !== undefined) {
+      expect(decoded.ok).toBe(false);
+    } else {
+      expect(decoded.ok).toBe(schemaAccepts(doc));
+    }
+  });
+});
+
+/**
+ * The same corpus, as configs a caller in code could pass with a cast or
+ * a JSON payload: each file entry renamed field by field. Code must refuse
+ * exactly what the file does -- shape included, since nothing but the
+ * type stops a caller passing `isExclusive: null` -- except an unknown
+ * key, which a file refuses and code ignores (as for object types).
+ */
+describe("createSubtypeFact refuses exactly what a file refuses", () => {
+  const ruleKeys = new Map(
+    Object.entries(DERIVATION_RULE_YAML_FIELDS).map(([k, y]) => [y, k] as const),
+  );
+  const fieldKeys = new Map(
+    Object.entries(SUBTYPE_FACT_YAML_FIELDS).map(([k, y]) => [y, k] as const),
+  );
+  const asConfig = (doc: Doc): Doc => {
+    const out: Doc = {};
+    for (const [yamlKey, v] of Object.entries(doc)) {
+      const key = fieldKeys.get(yamlKey) ?? yamlKey;
+      out[key] = key === "definingRule" && isMapping(v)
+        ? Object.fromEntries(Object.entries(v).map(([k, x]) => [ruleKeys.get(k) ?? k, x]))
+        : v;
+    }
+    return out;
+  };
+  const isMapping = (v: unknown): v is Doc =>
+    typeof v === "object" && v !== null && !Array.isArray(v);
+  const hasUnknownKey = (doc: Doc) =>
+    Object.keys(doc).some((k) => !fieldKeys.has(k))
+    || (isMapping(doc.defining_rule)
+      && Object.keys(doc.defining_rule).some((k) => !ruleKeys.has(k)));
+
+  const cases = corpus().filter((c) => !hasUnknownKey(c.doc));
+
+  it.each(cases)("$label", ({ doc }) => {
+    const fileRefuses = !decodeSubtypeFact(doc, never).ok;
+    let codeRefuses = false;
+    try {
+      createSubtypeFact(asConfig(doc) as unknown as SubtypeFactConfig, () => "minted");
+    } catch {
+      codeRefuses = true;
+    }
+    expect(codeRefuses).toBe(fileRefuses);
+  });
+
+  it("ignores an unknown key in code, and does not carry it", () => {
+    const sf = createSubtypeFact(
+      {
+        subtypeId: "a",
+        supertypeId: "b",
+        definingRule: { kind: "derived", expression: "x", colour: 1 },
+        colour: "red",
+      } as unknown as SubtypeFactConfig,
+      () => "minted",
+    );
+    expect(sf).toStrictEqual({
+      id: "minted",
+      subtypeId: "a",
+      supertypeId: "b",
+      providesIdentification: true,
+      isExclusive: false,
+      isExhaustive: false,
+      definingRule: { kind: "derived", expression: "x" },
+    });
+  });
+});
+
+describe("decodeSubtypeFact", () => {
+  it("decodes what the serializer writes back to the same subtype fact", () => {
+    for (const doc of [FULL, { id: "sf-2", subtype: "a", supertype: "b" }]) {
+      const first = decodeSubtypeFact(doc, never);
+      expect(first.ok).toBe(true);
+      if (!first.ok) continue;
+      expect(decodeSubtypeFact(serializeSubtypeFact(first.value), never)).toEqual(first);
+    }
+  });
+
+  it("builds a record with absent optional fields, not undefined ones", () => {
+    const result = decodeSubtypeFact({ id: "sf-2", subtype: "a", supertype: "b" }, never);
+    expect(result.ok && Object.keys(result.value)).toEqual([
+      "id",
+      "subtypeId",
+      "supertypeId",
+      "providesIdentification",
+      "isExclusive",
+      "isExhaustive",
+    ]);
+  });
+
+  it("reports every problem in one pass, each naming the subtype fact and the field", () => {
+    const result = decodeSubtypeFact({
+      id: "sf-1",
+      subtype: 7,
+      supertype: "",
+      is_exclusive: "yes",
+      defining_rule: { kind: "asserted", expression: "x" },
+      colour: "red",
+    }, never);
+    expect(result.ok).toBe(false);
+    if (result.ok) return;
+    expect(result.problems.map((p) => p.field).sort()).toEqual([
+      "colour",
+      "defining_rule",
+      "is_exclusive",
+      "subtype",
+      "supertype",
+    ]);
+    for (const p of result.problems) {
+      expect(p.subtypeFact).toBe("sf-1");
+      expect(p.message).toContain('"sf-1"');
+    }
+  });
+
+  it("names the subtype fact by its ends when the id is the problem", () => {
+    const result = decodeSubtypeFact({ id: "", subtype: "a", supertype: "b" }, never);
+    expect(result).toEqual({
+      ok: false,
+      problems: [{
+        subtypeFact: "",
+        field: "id",
+        message: 'The subtype fact from "a" to "b" must have a non-empty id, or none.',
+      }],
+    });
+  });
+
+  it("refuses an entry that is not a mapping", () => {
+    expect(decodeSubtypeFact(["a", "b"], never)).toMatchObject({
+      ok: false,
+      problems: [{ field: "", message: expect.stringContaining("not a list") }],
+    });
+  });
+});
+
+describe("the id source", () => {
+  afterEach(() => setIdGenerator(undefined));
+
+  it("is called once for an entry with no id, never for one that names it or fails", () => {
+    let calls = 0;
+    const newId = () => `minted-${++calls}`;
+    const { id: _id, ...noId } = FULL;
+    expect(decodeSubtypeFact(noId, newId)).toMatchObject({ ok: true, value: { id: "minted-1" } });
+    expect(decodeSubtypeFact(FULL, newId)).toMatchObject({ ok: true, value: { id: "sf-1" } });
+    expect(decodeSubtypeFact({ subtype: "a", supertype: "a" }, newId).ok).toBe(false);
+    expect(calls).toBe(1);
+  });
+
+  it("is the only one: the installed generator is never read", () => {
+    let installed = 0;
+    setIdGenerator(() => `installed-${++installed}`);
+    const { id: _id, ...noId } = FULL;
+    decodeSubtypeFact(noId, () => "given");
+    createSubtypeFact({ subtypeId: "a", supertypeId: "b" }, () => "given");
+    expect(installed).toBe(0);
+  });
+});
+
+/**
+ * Code against file, through the model. Every config here is one a typed
+ * caller can write; each is added to a model in code and loaded from a
+ * file holding the same model, and the two must refuse together. The ends
+ * range over an entity type, a second entity type, a value type, a missing
+ * id and an empty one, so the referential refusals are compared as well as
+ * the rules; a second subtype fact over the same pair is the duplicate.
+ */
+describe("a subtype fact in code is refused exactly when it is in a file", () => {
+  const OBJECT_TYPES = [
+    { id: "ot-a", name: "A", kind: "entity" as const, referenceMode: "a_id" },
+    { id: "ot-b", name: "B", kind: "entity" as const, referenceMode: "b_id" },
+    { id: "ot-v", name: "V", kind: "value" as const },
+  ];
+  const ENDS = ["ot-a", "ot-b", "ot-v", "ot-missing", ""];
+
+  function configs(): SubtypeFactConfig[][] {
+    const out: SubtypeFactConfig[][] = [];
+    for (const id of ["sf-1", ""]) {
+      for (const subtypeId of ENDS) {
+        for (const supertypeId of ENDS) {
+          out.push([{ id, subtypeId, supertypeId, isExclusive: true }]);
+        }
+      }
+    }
+    out.push([
+      { id: "sf-1", subtypeId: "ot-a", supertypeId: "ot-b" },
+      { id: "sf-2", subtypeId: "ot-a", supertypeId: "ot-b", isExhaustive: true },
+    ]);
+    out.push([{
+      id: "sf-1",
+      subtypeId: "ot-a",
+      supertypeId: "ot-b",
+      definingRule: { kind: "semiderived", storage: "derived_and_stored", expression: "" },
+    }]);
+    return out;
+  }
+
+  function refusedInCode(facts: SubtypeFactConfig[]): boolean {
+    const model = new OrmModel({ name: "M" });
+    for (const ot of OBJECT_TYPES) model.addObjectType(ot);
+    try {
+      for (const f of facts) model.addSubtypeFact(f);
+      return false;
+    } catch {
+      return true;
+    }
+  }
+
+  function refusedInFile(facts: SubtypeFactConfig[]): boolean {
+    const model = new OrmModel({ name: "M" });
+    for (const ot of OBJECT_TYPES) model.addObjectType(ot);
+    const serializer = new OrmYamlSerializer();
+    const doc = parse(serializer.serialize(model)) as { model: Record<string, unknown>; };
+    // Spelled by hand rather than by `serializeSubtypeFact`, which takes a
+    // built record: these configs are the ones that may not build.
+    doc.model.subtype_facts = facts.map((f) => ({
+      id: f.id,
+      subtype: f.subtypeId,
+      supertype: f.supertypeId,
+      ...(f.isExclusive !== undefined ? { is_exclusive: f.isExclusive } : {}),
+      ...(f.isExhaustive !== undefined ? { is_exhaustive: f.isExhaustive } : {}),
+      ...(f.definingRule !== undefined ? { defining_rule: f.definingRule } : {}),
+    }));
+    try {
+      serializer.deserialize(stringify(doc));
+      return false;
+    } catch {
+      return true;
+    }
+  }
+
+  const cases = configs();
+
+  it("the cases include both verdicts", () => {
+    const verdicts = cases.map(refusedInCode);
+    expect(verdicts).toContain(true);
+    expect(verdicts).toContain(false);
+  });
+
+  it.each(cases.map((facts) => ({ label: JSON.stringify(facts), facts })))(
+    "$label",
+    ({ facts }) => {
+      expect(refusedInFile(facts)).toBe(refusedInCode(facts));
+    },
+  );
+});
+
+describe("OrmYamlSerializer.deserialize", () => {
+  const serializer = new OrmYamlSerializer();
+
+  function refusal(yaml: string): DeserializationError {
+    try {
+      serializer.deserialize(yaml);
+    } catch (e) {
+      expect(e).toBeInstanceOf(DeserializationError);
+      return e as DeserializationError;
+    }
+    throw new Error("the document loaded");
+  }
+
+  const HEAD = `orm_version: "2.0"
+model:
+  name: M
+  object_types:
+    - { id: ot-a, name: A, kind: entity, reference_mode: a_id }
+    - { id: ot-b, name: B, kind: entity, reference_mode: b_id }
+`;
+
+  it("refuses a subtype fact with no id, naming it by its ends", () => {
+    const err = refusal(`${HEAD}  subtype_facts:
+    - { subtype: ot-a, supertype: ot-b }
+`);
+    expect(err.validationResult!.errors).toEqual([{
+      path: "/model/subtype_facts/0/id",
+      message: 'The subtype fact from "ot-a" to "ot-b" must have an id.',
+    }]);
+  });
+
+  it("reports subtype fact problems beside the schema's other errors, each once", () => {
+    const err = refusal(`${HEAD}  subtype_facts:
+    - { id: sf-1, subtype: ot-a, supertype: ot-a, colour: red }
+  fact_types: 3
+`);
+    expect(err.validationResult!.errors.map((e) => e.path)).toEqual([
+      "/model/fact_types",
+      "/model/subtype_facts/0/colour",
+      "/model/subtype_facts/0/supertype",
+    ]);
+  });
+});
