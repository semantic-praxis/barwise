--- /dev/null
+++ b/barwise/packages/core/src/model/shape.ts
@@ -0,0 +1,21 @@
+/**
+ * The two helpers every run-time shape check shares: the object type and
+ * subtype fact decoders, and `subtypeFactRuleProblems`, which checks the
+ * shape of a config built in code because an untyped caller (a cast, a
+ * JSON payload) can pass anything a file can. One copy, so a wrong value
+ * is worded alike wherever it is refused.
+ */
+
+/** A mapping of fields: an object that is not null and not a list. */
+export function isRecord(v: unknown): v is Readonly<Record<string, unknown>> {
+  return typeof v === "object" && v !== null && !Array.isArray(v);
+}
+
+/** How a wrong value reads in a message: what the reader wrote, briefly. */
+export function shown(v: unknown): string {
+  if (v === null) return "null";
+  if (Array.isArray(v)) return "a list";
+  if (typeof v === "object") return "a mapping";
+  if (typeof v === "string") return JSON.stringify(v);
+  return String(v);
+}
