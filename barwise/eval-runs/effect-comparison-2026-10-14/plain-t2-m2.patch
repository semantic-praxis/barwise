+import type { DerivationRule } from "../../model/FactType.js";
+import { isRecord, shown } from "../../model/shape.js";
+import {
+  buildSubtypeFact,
+  identifySubtypeFact,
+  type SubtypeFactConfig,
+  type SubtypeFactDecodeResult,
+  type SubtypeFactProblem,
+  subtypeFactRuleProblems,
+  type SubtypeFactSpelling,
+} from "../../model/SubtypeFact.js";
+
+/**
+ * Every config field and its YAML spelling: the one statement of which
+ * fields a subtype fact has in a file.
+ *
+ * `satisfies` checks it against `SubtypeFactConfig` both ways, and
+ * `tests/serialization/decodeSubtypeFact.test.ts` checks the YAML names
+ * against the JSON Schema's `subtype_fact` properties. The decoder refuses
+ * a key not listed here, which is the schema's `additionalProperties: false`.
+ */
+export const SUBTYPE_FACT_YAML_FIELDS = {
+  id: "id",
+  subtypeId: "subtype",
+  supertypeId: "supertype",
+  providesIdentification: "provides_identification",
+  isExclusive: "is_exclusive",
+  isExhaustive: "is_exhaustive",
+  definingRule: "defining_rule",
+} as const satisfies Record<keyof SubtypeFactConfig, string>;
+
+/**
+ * The defining rule's fields and their YAML spelling, the same table one
+ * level down; the test checks its YAML names against the schema's
+ * `derivation_rule_def` properties.
+ */
+export const DERIVATION_RULE_YAML_FIELDS = {
+  kind: "kind",
+  storage: "storage",
+  expression: "expression",
+  isFormal: "is_formal",
+} as const satisfies Record<keyof DerivationRule, string>;
+
+const YAML_SPELLING: SubtypeFactSpelling = {
+  field: (field) => SUBTYPE_FACT_YAML_FIELDS[field],
+  ruleField: (field) => DERIVATION_RULE_YAML_FIELDS[field],
+};
+
+const KNOWN_FIELDS: ReadonlySet<string> = new Set(Object.values(SUBTYPE_FACT_YAML_FIELDS));
+const KNOWN_RULE_FIELDS: ReadonlySet<string> = new Set(
+  Object.values(DERIVATION_RULE_YAML_FIELDS),
+);
+
+/** Rename a file mapping's keys to the config's, copying only those present. */
+function renamed<K extends string>(
+  doc: Readonly<Record<string, unknown>>,
+  table: Readonly<Record<K, string>>,
+): { [P in K]?: unknown; } {
+  const out: { [P in K]?: unknown; } = {};
+  for (const [key, yamlKey] of Object.entries(table) as [K, string][]) {
+    if (doc[yamlKey] !== undefined) out[key] = doc[yamlKey];
+  }
+  return out;
+}
+
+/**
+ * Turn one parsed YAML subtype fact into a `SubtypeFact`, or into every
+ * problem with it.
+ *
+ * The decoder's own check is the one thing a file can do and code cannot:
+ * carry a key the subtype fact does not have, at the top or inside the
+ * defining rule. Everything else -- each field's shape, an empty id or
+ * end, an end that is the other end -- is `subtypeFactRuleProblems`, the
+ * rules `createSubtypeFact` applies to a config built in code, read here
+ * with the fields renamed and the problems spelled as the file spells
+ * them. So the two entry points cannot disagree.
+ *
+ * `newId` is called once, and only for an entry with no `id` that decodes
+ * cleanly; the decoder never reads the process-wide generator.
+ */
+export function decodeSubtypeFact(doc: unknown, newId: () => string): SubtypeFactDecodeResult {
+  if (!isRecord(doc)) {
+    return {
+      ok: false,
+      problems: [{
+        subtypeFact: "",
+        field: "",
+        message: `A subtype fact must be a mapping of fields, not ${shown(doc)}.`,
+      }],
+    };
+  }
+
+  const { subtypeFact, subject } = identifySubtypeFact(doc.id, doc.subtype, doc.supertype);
+  const problems: SubtypeFactProblem[] = [];
+  const unknown = (field: string, path: string) => {
+    problems.push({ subtypeFact, field, message: `${subject} has an unknown field \`${path}\`.` });
+  };
+
+  for (const key of Object.keys(doc)) {
+    if (!KNOWN_FIELDS.has(key)) unknown(key, key);
+  }
+
+  const config = renamed(doc, SUBTYPE_FACT_YAML_FIELDS);
+  const rawRule = doc.defining_rule;
+  if (isRecord(rawRule)) {
+    for (const key of Object.keys(rawRule)) {
+      if (!KNOWN_RULE_FIELDS.has(key)) {
+        unknown(SUBTYPE_FACT_YAML_FIELDS.definingRule, `defining_rule.${key}`);
+      }
+    }
+    const rule = renamed(rawRule, DERIVATION_RULE_YAML_FIELDS);
+    // `is_formal: false` is read as absent: the serializer writes only a
+    // true flag (`serializeDerivation`), so what it writes decodes back to
+    // the same record. A non-boolean stays, for the rule to refuse.
+    if (rule.isFormal === false) delete rule.isFormal;
+    config.definingRule = rule;
+  }
+
+  problems.push(...subtypeFactRuleProblems(config, YAML_SPELLING));
+  if (problems.length > 0) return { ok: false, problems };
+  return { ok: true, value: buildSubtypeFact(config as SubtypeFactConfig, newId) };
+}
