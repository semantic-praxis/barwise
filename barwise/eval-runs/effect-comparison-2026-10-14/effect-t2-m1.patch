+/**
+ * The subtype fact as a sealed record (core-branching-load.spec.md WS1):
+ * a plain frozen record with no class, methods or derived name, built by
+ * `OrmModel.addSubtypeFact` through the decoder, and refused in code exactly
+ * when the same subtype fact in a file is refused.
+ */
+import * as Effect from "effect/Effect";
+import * as Result from "effect/Result";
+import { describe, expect, it } from "vitest";
+import { IdSource } from "../../src/model/decoding.js";
+import { OrmModel } from "../../src/model/OrmModel.js";
+import { createSubtypeFact } from "../../src/model/SubtypeFact.js";
+import {
+  decodeSubtypeFact,
+  decodeSubtypeFactConfig,
+  SubtypeFactError,
+  type SubtypeFactProblem,
+  type SubtypeFactProblems,
+} from "../../src/model/subtypeFactDecoder.js";
+import type { SubtypeFact } from "../../src/model/subtypeFactSchema.js";
+import { OrmYamlSerializer } from "../../src/serialization/OrmYamlSerializer.js";
+import { serializeSubtypeFact } from "../../src/serialization/yaml/subtype.js";
+
+function run(
+  decoded: Effect.Effect<SubtypeFact, SubtypeFactProblems, IdSource>,
+): Result.Result<SubtypeFact, readonly SubtypeFactProblem[]> {
+  let n = 0;
+  return Effect.runSync(
+    decoded.pipe(
+      Effect.mapError((e) => e.problems),
+      Effect.result,
+      Effect.provideService(IdSource, { newId: () => `minted-${++n}` }),
+    ),
+  );
+}
+
+function problems(decoded: Effect.Effect<SubtypeFact, SubtypeFactProblems, IdSource>) {
+  const result = run(decoded);
+  if (Result.isSuccess(result)) throw new Error("expected the decode to fail");
+  return result.failure;
+}
+
+describe("the SubtypeFact record", () => {
+  it("is a plain frozen record: no class, no name, and an absent rule is absent", () => {
+    const sf = createSubtypeFact({ id: "sf-1", subtypeId: "a", supertypeId: "b" });
+    expect(Object.getPrototypeOf(sf)).toBe(Object.prototype);
+    expect(Object.isFrozen(sf)).toBe(true);
+    expect(Object.keys(sf).sort()).toEqual(
+      ["id", "isExclusive", "isExhaustive", "providesIdentification", "subtypeId", "supertypeId"],
+    );
+    expect("name" in sf).toBe(false);
+    expect("definingRule" in sf).toBe(false);
+  });
+
+  it("freezes its defining rule too", () => {
+    const sf = createSubtypeFact({
+      subtypeId: "a",
+      supertypeId: "b",
+      definingRule: { kind: "derived", expression: "each A who is old" },
+    });
+    expect(Object.isFrozen(sf.definingRule)).toBe(true);
+  });
+
+  it("treats a key holding undefined as absent, and spreads back into a config", () => {
+    const sf = createSubtypeFact({
+      id: "sf-1",
+      subtypeId: "a",
+      supertypeId: "b",
+      definingRule: undefined,
+    });
+    expect("definingRule" in sf).toBe(false);
+    expect(createSubtypeFact({ ...sf })).toEqual(sf);
+  });
+
+  it("decodes a file's subtype fact into the same record", () => {
+    const result = run(decodeSubtypeFact({
+      id: "sf-1",
+      subtype: "a",
+      supertype: "b",
+      provides_identification: false,
+      defining_rule: { kind: "semiderived", expression: "x", is_formal: false },
+    }));
+    expect(Result.isSuccess(result) && result.success).toEqual({
+      id: "sf-1",
+      subtypeId: "a",
+      supertypeId: "b",
+      providesIdentification: false,
+      isExclusive: false,
+      isExhaustive: false,
+      definingRule: { kind: "semiderived", expression: "x", isFormal: false },
+    });
+  });
+
+  it("reports every problem in one pass, each at the key the input used", () => {
+    const found = problems(decodeSubtypeFact({
+      id: "sf-1",
+      subtype: "",
+      is_exclusive: "yes",
+      defining_rule: { kind: "guessed", expression: "x", isFormal: true },
+      colour: "red",
+    }));
+    expect(found.map((p) => p.field).sort()).toEqual(
+      ["colour", "defining_rule", "defining_rule", "is_exclusive", "subtype", "supertype"],
+    );
+    for (const p of found) {
+      expect(p.subtypeFact).toBe("sf-1");
+      expect(p.message).toMatch(/^Subtype fact "sf-1" /);
+    }
+    expect(found.find((p) => p.field === "supertype")?.message).toBe(
+      'Subtype fact "sf-1" must name its supertype.',
+    );
+  });
+
+  it("names a subtype fact without an id by the ids it relates", () => {
+    expect(problems(decodeSubtypeFactConfig({ subtypeId: "a", supertypeId: "a" }))).toEqual([{
+      subtypeFact: "",
+      field: "",
+      message:
+        'Subtype fact from "a" to "a" cannot have the same entity as both subtype and supertype.',
+    }]);
+  });
+
+  it("is thrown at the boundary as one error carrying every problem", () => {
+    let caught: unknown;
+    try {
+      createSubtypeFact({ id: "", subtypeId: "", supertypeId: "b" });
+    } catch (e) {
+      caught = e;
+    }
+    expect(caught).toBeInstanceOf(SubtypeFactError);
+    expect((caught as SubtypeFactError).problems.map((p) => p.field).sort()).toEqual(
+      ["id", "subtypeId"],
+    );
+  });
+});
+
+describe("a subtype fact built in code and the same one in a file", () => {
+  const SNAKE: Record<string, string> = {
+    subtypeId: "subtype",
+    supertypeId: "supertype",
+    providesIdentification: "provides_identification",
+    isExclusive: "is_exclusive",
+    isExhaustive: "is_exhaustive",
+    definingRule: "defining_rule",
+    isFormal: "is_formal",
+  };
+
+  /** The config in the file's spelling, at any depth. */
+  function toFile(value: unknown): unknown {
+    if (value === null || typeof value !== "object" || Array.isArray(value)) return value;
+    return Object.fromEntries(
+      Object.entries(value).map(([k, v]) => [SNAKE[k] ?? k, toFile(v)]),
+    );
+  }
+
+  function modelWithEnds(): OrmModel {
+    const model = new OrmModel({ name: "M" });
+    model.addObjectType({ id: "a", name: "A", kind: "entity", referenceMode: "a_id" });
+    model.addObjectType({ id: "b", name: "B", kind: "entity", referenceMode: "b_id" });
+    model.addObjectType({ id: "v", name: "V", kind: "value" });
+    return model;
+  }
+
+  function refusedInCode(config: Record<string, unknown>): boolean {
+    try {
+      modelWithEnds().addSubtypeFact(config as never);
+      return false;
+    } catch {
+      return true;
+    }
+  }
+
+  function refusedInFile(config: Record<string, unknown>): boolean {
+    const yaml = new OrmYamlSerializer().serialize(modelWithEnds()).replace(
+      /\n$/,
+      `\n  subtype_facts:\n    - ${JSON.stringify(toFile(config))}\n`,
+    );
+    try {
+      new OrmYamlSerializer().deserialize(yaml);
+      return false;
+    } catch {
+      // A malformed record is a DeserializationError; a model refusal (an
+      // end missing or not an entity) is the plain Error the loader has
+      // always let through from addSubtypeFact.
+      return true;
+    }
+  }
+
+  const rule = { kind: "derived", expression: "each A who is old" };
+  const cases: Record<string, Record<string, unknown>> = {
+    "a well-formed one": { id: "sf", subtypeId: "a", supertypeId: "b" },
+    "every field set": {
+      id: "sf",
+      subtypeId: "a",
+      supertypeId: "b",
+      providesIdentification: false,
+      isExclusive: true,
+      isExhaustive: true,
+      definingRule: { ...rule, storage: "derived_and_stored", isFormal: false },
+    },
+    "an empty id": { id: "", subtypeId: "a", supertypeId: "b" },
+    "an empty subtype": { id: "sf", subtypeId: "", supertypeId: "b" },
+    "no supertype": { id: "sf", subtypeId: "a" },
+    "the same entity at both ends": { id: "sf", subtypeId: "a", supertypeId: "a" },
+    "an end that does not exist": { id: "sf", subtypeId: "a", supertypeId: "nope" },
+    "a value type at one end": { id: "sf", subtypeId: "v", supertypeId: "b" },
+    "a flag that is not a boolean": { id: "sf", subtypeId: "a", supertypeId: "b", isExhaustive: 1 },
+    "an id that is not a string": { id: 7, subtypeId: "a", supertypeId: "b" },
+    "an unknown key": { id: "sf", subtypeId: "a", supertypeId: "b", colour: "red" },
+    "a rule of an unknown kind": {
+      id: "sf",
+      subtypeId: "a",
+      supertypeId: "b",
+      definingRule: { ...rule, kind: "guessed" },
+    },
+    "a rule of an unknown storage": {
+      id: "sf",
+      subtypeId: "a",
+      supertypeId: "b",
+      definingRule: { ...rule, storage: "cached" },
+    },
+    "a rule without an expression": {
+      id: "sf",
+      subtypeId: "a",
+      supertypeId: "b",
+      definingRule: { kind: "derived" },
+    },
+    "a rule with an unknown key": {
+      id: "sf",
+      subtypeId: "a",
+      supertypeId: "b",
+      definingRule: { ...rule, author: "x" },
+    },
+  };
+
+  it.each(Object.entries(cases))("are refused alike: %s", (_, config) => {
+    expect(refusedInCode(config)).toBe(refusedInFile(config));
+  });
+
+  it("are both accepted when well-formed and both refused otherwise", () => {
+    const accepted = Object.entries(cases).filter(([, c]) => !refusedInCode(c)).map(([k]) => k);
+    expect(accepted.sort()).toEqual(["a well-formed one", "every field set"]);
+  });
+
+  it("round-trip to the same record", () => {
+    const model = modelWithEnds();
+    const sf = model.addSubtypeFact(cases["every field set"] as never);
+    const loaded = new OrmYamlSerializer().deserialize(new OrmYamlSerializer().serialize(model));
+    expect(serializeSubtypeFact(loaded.getSubtypeFact("sf")!)).toEqual(serializeSubtypeFact(sf));
+  });
+});
