+/**
+ * A derivation rule, stated once as an Effect Schema: the record type both
+ * derived fact types and subtype-defining rules carry, and its YAML spelling
+ * (`derivation_rule_def` in the JSON Schema). A subtype fact's decoder
+ * (`subtypeFactSchema.ts`) checks one against it; `FactType` takes the type.
+ */
+import * as Schema from "effect/Schema";
+
+/**
+ * The definitional axis of a derived element: `derived` (`*`, fully defined
+ * by the rule) or `semiderived` (`+`, a partial/conditional definition). An
+ * asserted (base) fact type has no derivation at all.
+ */
+const DerivationKindSchema = Schema.Literals(["derived", "semiderived"]);
+
+/**
+ * The storage axis of a derived element, orthogonal to the definitional
+ * axis: `derive_on_request` (`*`, computed on demand, the default) or
+ * `derived_and_stored` (`**`, eagerly materialized).
+ */
+const DerivationStorageSchema = Schema.Literals(["derive_on_request", "derived_and_stored"]);
+
+/**
+ * A derivation rule: how a derived fact type's (or subtype's) population is
+ * defined. In v1 the rule is informal -- opaque text carried verbatim and
+ * verbalized, never parsed or executed by core (ADR-0001 filter 3). The
+ * `isFormal` flag is reserved for a future formal grammar; it is absent or
+ * false in v1.
+ */
+export const DerivationRuleSchema = Schema.Struct({
+  /** Definitional axis: fully derived (`*`) or semiderived (`+`). */
+  kind: DerivationKindSchema,
+  /** Storage axis: on-request (`*`, default) or stored (`**`). */
+  storage: Schema.optionalKey(DerivationStorageSchema),
+  /** The rule text (natural language or hand-written FORML). */
+  expression: Schema.String,
+  /** Reserved: true once the expression is a parsed formal rule. */
+  isFormal: Schema.optionalKey(Schema.Boolean),
+});
+
+/** The YAML key of every derivation rule key that is not spelled the same. */
+export const DERIVATION_YAML_KEYS = { isFormal: "is_formal" } as const;
+
+/** A derivation rule as an `.orm.yaml` file spells it. */
+export const DerivationRuleYamlSchema = DerivationRuleSchema.pipe(
+  Schema.encodeKeys(DERIVATION_YAML_KEYS),
+);
+
+/** See `DerivationKindSchema`. */
+export type DerivationKind = typeof DerivationKindSchema.Type;
+
+/** See `DerivationStorageSchema`. */
+export type DerivationStorage = typeof DerivationStorageSchema.Type;
+
+/** See `DerivationRuleSchema`. */
+export type DerivationRule = typeof DerivationRuleSchema.Type;
