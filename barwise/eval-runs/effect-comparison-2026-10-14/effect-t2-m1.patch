+++ b/barwise/packages/core/tests/model/subtypeFactSchemaDrift.test.ts
@@ -0,0 +1,50 @@
+/**
+ * The JSON Schema's `subtype_fact` against the decoder's schema, compared
+ * the way `objectTypeSchemaDrift.test.ts` compares object types and for the
+ * same reason: the JSON Schema stays hand-written, so the two statements are
+ * held to the same facts here, and the differences must be exactly the ones
+ * listed. The non-empty strings (`minLength: 1`) and the distinct ends are
+ * checks the generator cannot render; `subtypeFactDecoder.test.ts` pins them.
+ */
+import * as Schema from "effect/Schema";
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { SubtypeFactYamlCodec } from "../../src/model/subtypeFactSchema.js";
+import { differences, facts } from "../helpers/jsonSchemaFacts.js";
+
+const fileSchema = JSON.parse(
+  readFileSync(new URL("../../schemas/orm-model.schema.json", import.meta.url), "utf8"),
+) as { definitions: Record<string, Record<string, unknown>>; };
+
+const fileFacts = () => facts(fileSchema.definitions.subtype_fact!, fileSchema.definitions);
+const decoderFacts = () =>
+  facts(Schema.toJsonSchemaDocument(SubtypeFactYamlCodec).schema as Record<string, unknown>, {});
+
+/** Where the two are meant to differ; each entry must still be a difference. */
+const KNOWN: Record<string, string> = {
+  "subtype_fact.required":
+    "a file must carry an id; the decoder mints a missing one from IdSource, and the loader keeps the schema's refusal",
+};
+
+describe("the JSON Schema's subtype_fact and the decoder's", () => {
+  it("hold a subtype fact to the same facts, but for the known differences", () => {
+    expect(differences(fileFacts(), decoderFacts(), "subtype_fact").sort()).toEqual(
+      Object.keys(KNOWN).sort(),
+    );
+  });
+
+  it("sees a storage dropped from the file schema's defining rule", () => {
+    const rule = fileSchema.definitions.derivation_rule_def as {
+      properties: { storage: { enum: string[]; }; };
+    };
+    const original = rule.properties.storage.enum;
+    rule.properties.storage.enum = original.filter((s) => s !== "derived_and_stored");
+    try {
+      expect(differences(fileFacts(), decoderFacts(), "subtype_fact")).toContain(
+        "subtype_fact.properties.defining_rule.properties.storage.enum",
+      );
+    } finally {
+      rule.properties.storage.enum = original;
+    }
+  });
+});
