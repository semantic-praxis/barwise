@@ -0,0 +1,141 @@
+/**
+ * Decoding one subtype fact into its record, or into every problem with it --
+ * the object type decoder's contract (`objectTypeDecoder.ts`) for the next
+ * element kind: every problem in one pass, one per entry, each naming the
+ * subtype fact and the field, with fresh ids only from `IdSource`.
+ */
+import * as Effect from "effect/Effect";
+import * as Result from "effect/Result";
+import * as Schema from "effect/Schema";
+import type * as SchemaIssue from "effect/SchemaIssue";
+import {
+  type FieldProblem,
+  fieldProblems,
+  type IdSource,
+  PARSE_OPTIONS,
+  runWithIds,
+  withoutUndefined,
+} from "./decoding.js";
+import {
+  SUBTYPE_FACT_FILE_SPELLING,
+  type SubtypeFact,
+  SubtypeFactModelCodec,
+  SubtypeFactYamlCodec,
+} from "./subtypeFactSchema.js";
+
+/** One thing wrong with one subtype fact. */
+export interface SubtypeFactProblem {
+  /** The subtype fact's id, or `""` when it has none to name it by. */
+  readonly subtypeFact: string;
+  /** The top-level field at fault, in the spelling of the input; `""` for the record as a whole. */
+  readonly field: string;
+  /** A sentence naming the subtype fact and the field. */
+  readonly message: string;
+}
+
+/** Every problem one decode found; never empty. */
+export class SubtypeFactProblems {
+  readonly _tag = "SubtypeFactProblems";
+  constructor(readonly problems: readonly [SubtypeFactProblem, ...SubtypeFactProblem[]]) {}
+}
+
+/** Thrown at the synchronous boundaries, carrying the list as well as the joined text. */
+export class SubtypeFactError extends Error {
+  constructor(readonly problems: readonly [SubtypeFactProblem, ...SubtypeFactProblem[]]) {
+    super(problems.map((p) => p.message).join("\n"));
+    this.name = "SubtypeFactError";
+  }
+}
+
+const decodeYaml = Schema.decodeUnknownEffect(SubtypeFactYamlCodec, PARSE_OPTIONS);
+const decodeModel = Schema.decodeUnknownEffect(SubtypeFactModelCodec, PARSE_OPTIONS);
+
+/** Decode one subtype fact as an `.orm.yaml` file spells it. */
+export function decodeSubtypeFact(
+  doc: unknown,
+): Effect.Effect<SubtypeFact, SubtypeFactProblems, IdSource> {
+  return decodeWith(decodeYaml, doc);
+}
+
+/**
+ * Decode one subtype fact as `SubtypeFactConfig` spells it. A key holding
+ * `undefined` is treated as absent first, as it is for an object type.
+ */
+export function decodeSubtypeFactConfig(
+  config: unknown,
+): Effect.Effect<SubtypeFact, SubtypeFactProblems, IdSource> {
+  return decodeWith(decodeModel, withoutUndefined(config));
+}
+
+/**
+ * Decode a file's subtype facts, each to its record or its problems, so one
+ * pass reports everything wrong with all of them.
+ */
+export function decodeSubtypeFacts(
+  docs: readonly unknown[],
+): Effect.Effect<readonly Result.Result<SubtypeFact, SubtypeFactProblems>[], never, IdSource> {
+  return Effect.forEach(docs, (doc) => Effect.result(decodeSubtypeFact(doc)));
+}
+
+/**
+ * Run one decode with ids from `newId`, returning the record or throwing
+ * every problem at once as a `SubtypeFactError`.
+ */
+export function runSubtypeFactDecode(
+  decoded: Effect.Effect<SubtypeFact, SubtypeFactProblems, IdSource>,
+  newId: () => string,
+): SubtypeFact {
+  const result = runWithIds(Effect.result(decoded), newId);
+  if (Result.isFailure(result)) throw new SubtypeFactError(result.failure.problems);
+  return result.success;
+}
+
+function decodeWith(
+  decode: (input: unknown) => Effect.Effect<SubtypeFact, Schema.SchemaError, IdSource>,
+  input: unknown,
+): Effect.Effect<SubtypeFact, SubtypeFactProblems, IdSource> {
+  return decode(input).pipe(
+    Effect.map(seal),
+    Effect.mapError((error) => new SubtypeFactProblems(problemsOf(error.issue, input))),
+  );
+}
+
+/** Frozen, rule and all: a record is a value. */
+function seal(sf: SubtypeFact): SubtypeFact {
+  return Object.freeze(
+    sf.definingRule === undefined
+      ? { ...sf }
+      : { ...sf, definingRule: Object.freeze({ ...sf.definingRule }) },
+  );
+}
+
+function problemsOf(
+  issue: SchemaIssue.Issue,
+  raw: unknown,
+): [SubtypeFactProblem, ...SubtypeFactProblem[]] {
+  const subject = subjectOf(raw);
+  const [first, ...rest] = fieldProblems(issue, raw, {
+    label: subject.label,
+    fileSpelling: SUBTYPE_FACT_FILE_SPELLING,
+    rootField: "",
+  });
+  const attach = (p: FieldProblem): SubtypeFactProblem => ({ subtypeFact: subject.identity, ...p });
+  return [attach(first), ...rest.map(attach)];
+}
+
+/**
+ * What a message calls the subtype fact: by its id, or by the two ids it
+ * relates when it has none (a config may leave the id to be minted).
+ */
+function subjectOf(raw: unknown): { readonly label: string; readonly identity: string; } {
+  const doc = raw !== null && typeof raw === "object" ? (raw as Record<string, unknown>) : {};
+  if (typeof doc.id === "string" && doc.id !== "") {
+    return { label: `Subtype fact "${doc.id}"`, identity: doc.id };
+  }
+  const sub = doc.subtypeId ?? doc.subtype;
+  const sup = doc.supertypeId ?? doc.supertype;
+  if (typeof sub === "string" && sub !== "" && typeof sup === "string" && sup !== "") {
+    return { label: `Subtype fact from "${sub}" to "${sup}"`, identity: "" };
+  }
+  return { label: "Subtype fact with no id", identity: "" };
+}
diff --git a/barwise/packages/core/src/model/subtypeFactSchema.ts b/barwise/packages/core/src/model/subtypeFactSchema.ts
new file mode 100644
index 00000000..7aaa11ee
--- /dev/null
+++ b/barwise/packages/core/src/model/subtypeFactSchema.ts
@@ -0,0 +1,134 @@
+/**
+ * The subtype fact, stated once: the record type, the rules a model and a
+ * file must satisfy, and the YAML spelling, as one Effect Schema definition
+ * -- the shape `objectTypeSchema.ts` gave object types.
+ *
+ * `SubtypeFact` is the decoded type of the struct below; the refusals the
+ * old class constructor made, and the ones the JSON Schema made of a file
+ * alone, are its checks; the YAML codec is the same struct with renamed keys.
+ * The JSON Schema stays hand-written, and
+ * `tests/model/subtypeFactSchemaDrift.test.ts` compares it with this one.
+ *
+ * What is not here is what needs the model: whether the two ends exist, are
+ * entity types, and are not already related. `OrmModel.addSubtypeFact` checks
+ * those, for a file and a caller alike.
+ */
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import { IdSource } from "./decoding.js";
+import {
+  DERIVATION_YAML_KEYS,
+  DerivationRuleSchema,
+  DerivationRuleYamlSchema,
+} from "./derivationRuleSchema.js";
+
+// Every `message` below is the predicate of a sentence whose subject the
+// decoder supplies ('Subtype fact "sf-1" must name its subtype.').
+
+/** A reference or id: the JSON Schema's `minLength: 1`, stated as a check. */
+function nonEmpty(message: string) {
+  return Schema.String.check(Schema.makeFilter((s: string) => s !== "", { message }));
+}
+
+function fields<R extends typeof DerivationRuleSchema | typeof DerivationRuleYamlSchema>(
+  definingRule: R,
+) {
+  return {
+    /** Minted from `IdSource` when absent. */
+    id: nonEmpty("must have a non-empty id.").pipe(
+      Schema.withDecodingDefaultKey(IdSource.useSync((ids) => ids.newId())),
+    ),
+    /** The id of the subtype (child) entity type. */
+    subtypeId: nonEmpty("must name its subtype.").pipe(
+      Schema.annotateKey({ messageMissingKey: "must name its subtype." }),
+    ),
+    /** The id of the supertype (parent) entity type. */
+    supertypeId: nonEmpty("must name its supertype.").pipe(
+      Schema.annotateKey({ messageMissingKey: "must name its supertype." }),
+    ),
+    /**
+     * Whether the subtype uses the supertype's reference scheme for
+     * identification (preferred identification path). When true, the
+     * subtype does not need its own reference mode -- it inherits the
+     * supertype's PK in relational mapping. Always present; default true.
+     */
+    providesIdentification: Schema.Boolean.pipe(
+      Schema.withDecodingDefaultKey(Effect.succeed(true)),
+    ),
+    /**
+     * Whether the subtypes of this supertype are mutually exclusive: no
+     * supertype instance is an instance of more than one subtype in the
+     * partition group (all subtype facts sharing the supertype with
+     * `isExclusive`). In ORM 2, an exclusion constraint across the
+     * supertype meta-roles of the partition. Always present; default false.
+     */
+    isExclusive: Schema.Boolean.pipe(Schema.withDecodingDefaultKey(Effect.succeed(false))),
+    /**
+     * Whether the subtypes of this supertype are exhaustive: every
+     * supertype instance is an instance of at least one subtype in the
+     * partition group. In ORM 2, a disjunctive mandatory constraint across
+     * the supertype meta-roles of the partition. Always present; default
+     * false.
+     */
+    isExhaustive: Schema.Boolean.pipe(Schema.withDecodingDefaultKey(Effect.succeed(false))),
+    /**
+     * Defining rule when this subtype's membership is determined by a
+     * derivation rule (Halpin's subtype-defining rules) rather than
+     * asserted. Absent for an asserted subtype.
+     */
+    definingRule: Schema.optionalKey(definingRule),
+  };
+}
+
+/**
+ * The one rule over the whole record: a subtype fact relates two different
+ * entity types. A check on the struct rather than a field, so it is reported
+ * once, and only when both ends decoded.
+ */
+const distinctEnds = Schema.makeFilter(
+  (sf: { readonly subtypeId: string; readonly supertypeId: string; }) =>
+    sf.subtypeId !== sf.supertypeId,
+  { message: "cannot have the same entity as both subtype and supertype." },
+);
+
+/** The YAML key of every subtype fact key that is not spelled the same. */
+export const SUBTYPE_FACT_YAML_KEYS = {
+  subtypeId: "subtype",
+  supertypeId: "supertype",
+  providesIdentification: "provides_identification",
+  isExclusive: "is_exclusive",
+  isExhaustive: "is_exhaustive",
+  definingRule: "defining_rule",
+} as const;
+
+/** Every decoded key a file spells differently, at any depth of a subtype fact. */
+export const SUBTYPE_FACT_FILE_SPELLING: Readonly<Record<string, string>> = {
+  ...SUBTYPE_FACT_YAML_KEYS,
+  ...DERIVATION_YAML_KEYS,
+};
+
+/** A subtype fact as a caller of `OrmModel.addSubtypeFact` spells it, decoded into the record. */
+export const SubtypeFactModelCodec = Schema.Struct(fields(DerivationRuleSchema)).check(
+  distinctEnds,
+);
+
+/** A subtype fact as an `.orm.yaml` file spells it, decoded into the same record. */
+export const SubtypeFactYamlCodec = Schema.Struct(fields(DerivationRuleYamlSchema))
+  .pipe(Schema.encodeKeys(SUBTYPE_FACT_YAML_KEYS))
+  .check(distinctEnds);
+
+/**
+ * A SubtypeFact represents a specialization relationship in ORM: entity type
+ * A is a subtype of entity type B. Every instance of the subtype is also an
+ * instance of the supertype, and the subtype inherits the supertype's fact
+ * types and constraints. Example: "Employee is a subtype of Person".
+ *
+ * In relational mapping, subtype facts determine whether the subtype is
+ * absorbed into the supertype's table or gets its own table with a FK back
+ * to the supertype.
+ *
