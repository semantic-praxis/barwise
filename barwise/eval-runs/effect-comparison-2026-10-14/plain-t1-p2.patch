diff --git a/barwise/packages/core/tests/model/valueTypeUnit.test.ts b/barwise/packages/core/tests/model/valueTypeUnit.test.ts
new file mode 100644
index 00000000..008f28e9
--- /dev/null
+++ b/barwise/packages/core/tests/model/valueTypeUnit.test.ts
@@ -0,0 +1,108 @@
+/**
+ * A value type's `unit`: construction, YAML both ways, and the diff.
+ *
+ * The cases the generated suites already cover are not repeated here: the
+ * entity refusal by `createObjectType` and the schema is generated from
+ * `VALUE_ONLY_FIELDS` (`valueOnlyFields.test.ts`), and the decoder's verdict
+ * on every shape of `unit` is compared with the schema's
+ * (`decodeObjectType.test.ts`).
+ */
+import { describe, expect, it } from "vitest";
+import { diffModels } from "../../src/diff/ModelDiff.js";
+import { createObjectType, isValueType } from "../../src/model/ObjectType.js";
+import { OrmModel } from "../../src/model/OrmModel.js";
+import { OrmYamlSerializer } from "../../src/serialization/OrmYamlSerializer.js";
+import { decodeObjectType } from "../../src/serialization/yaml/decodeObjectType.js";
+
+let minted = 0;
+const newId = () => `ot-${++minted}`;
+
+function modelWithWeight(unit: string | undefined): OrmModel {
+  const model = new OrmModel({ name: "Units" });
+  model.addObjectType({
+    id: "ot-weight",
+    name: "Weight",
+    kind: "value",
+    dataType: { name: "decimal", length: 8, scale: 2 },
+    ...(unit !== undefined ? { unit } : {}),
+    defaultValue: "0",
+  });
+  return model;
+}
+
+describe("value type unit", () => {
+  const serializer = new OrmYamlSerializer();
+
+  it("round-trips through YAML", () => {
+    const model = modelWithWeight("kg");
+    const back = serializer.deserialize(serializer.serialize(model));
+    const weight = back.getObjectType("ot-weight");
+    expect(weight && isValueType(weight) ? weight.unit : undefined).toBe("kg");
+    expect(back.getObjectType("ot-weight")).toEqual(model.getObjectType("ot-weight"));
+  });
+
+  it("is written right after the data type it qualifies", () => {
+    expect(serializer.serialize(modelWithWeight("kg"))).toContain(
+      "      data_type:\n        name: decimal\n        length: 8\n        scale: 2\n"
+        + '      unit: kg\n      default_value: "0"\n',
+    );
+  });
+
+  it("is absent from the record and the file when not given", () => {
+    const model = modelWithWeight(undefined);
+    expect(model.getObjectType("ot-weight")).not.toHaveProperty("unit");
+    expect(serializer.serialize(model)).not.toContain("unit:");
+  });
+
+  it("is refused when empty, from code and from a file alike", () => {
+    expect(() => createObjectType({ name: "Weight", kind: "value", unit: "" }, newId)).toThrow(
+      'Unit on "Weight" must be a non-empty string; omit it for no unit.',
+    );
+    expect(decodeObjectType({ name: "Weight", kind: "value", unit: "" }, newId)).toEqual({
+      ok: false,
+      problems: [{
+        objectType: "Weight",
+        field: "unit",
+        message: 'Unit on "Weight" must be a non-empty string; omit it for no unit.',
+      }],
+    });
+  });
+
+  it("is refused on an entity type when decoding a file, naming the type and the field", () => {
+    const decoded = decodeObjectType({
+      id: "ot-parcel",
+      name: "Parcel",
+      kind: "entity",
+      reference_mode: "parcel_id",
+      unit: "kg",
+    }, newId);
+    expect(decoded).toEqual({
+      ok: false,
+      problems: [{
+        objectType: "Parcel",
+        field: "unit",
+        message:
+          'Entity type "Parcel" cannot have a unit; it belongs on the value type its reference mode names.',
+      }],
+    });
+  });
+
+  it("a changed unit is reported by the diff", () => {
+    const delta = diffModels(modelWithWeight("kg"), modelWithWeight("lb"));
+    const modified = delta.deltas.filter((d) => d.kind === "modified");
+    expect(modified).toHaveLength(1);
+    expect(modified[0]!.changes).toEqual([{ change: "unit", from: "kg", to: "lb" }]);
+    expect(modified[0]!.changeDescriptions).toEqual(['unit: "kg" -> "lb"']);
+  });
+
+  it("an added and a removed unit are reported by the diff", () => {
+    const added = diffModels(modelWithWeight(undefined), modelWithWeight("kg"));
+    const removed = diffModels(modelWithWeight("kg"), modelWithWeight(undefined));
+    expect(added.deltas.flatMap((d) => d.kind === "modified" ? d.changes : [])).toEqual([
+      { change: "unit", from: undefined, to: "kg" },
+    ]);
+    expect(removed.deltas.flatMap((d) => d.kind === "modified" ? d.changes : [])).toEqual([
+      { change: "unit", from: "kg", to: undefined },
+    ]);
+  });
+});
