+/**
+ * A unit derived from the data type already drawn, rather than drawn itself.
+ *
+ * The law baselines (`counterexample.law.test.ts` among them) record what
+ * the sampled models do at a fixed seed, and a new draw anywhere in
+ * `arbRawObjectType` shifts every model after it. Deriving the unit from a
+ * value the generator already draws puts it in front of the serialization
+ * law -- present on some value types, absent on others, varied in spelling
+ * -- without moving the sample stream those baselines were taken on.
+ */
+const UNITS = ["kg", "USD", "ms", "m/s", "%"] as const;
+
+function toUnit(raw: RawObjectType["dataType"]): string | undefined {
+  if (raw === null || raw.scale === null) return undefined;
+  return UNITS[raw.scale % UNITS.length];
+}
