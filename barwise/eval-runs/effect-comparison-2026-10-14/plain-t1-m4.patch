+/**
+ * A unit, derived from the data type's length rather than drawn. Drawing it
+ * would add a field to the record arbitrary and shift every value sampled
+ * after it, and `counterexample.law.test.ts` ratchets on what one fixed seed
+ * samples: the models it checks would change under it for a field it never
+ * reads. Present on roughly half the value types that have a data type, so
+ * the serialization law still round-trips it.
+ */
+const UNITS = ["kg", "m", "USD", "ms"] as const;
+function toUnit(raw: RawObjectType["dataType"]): string | undefined {
+  if (raw === null || raw.length === null) return undefined;
+  return UNITS[raw.length % UNITS.length];
