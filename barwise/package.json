{
  "name": "barwise",
  "version": "1.7.0",
  "private": true,
  "description": "ORM 2 modeling tool for data engineers and architects",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && node --test scripts/tests/*.test.mjs",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "knip": "knip",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "check:depcruise-gate": "node scripts/check-depcruise-gate.mjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:no-nul": "node scripts/check-no-nul.mjs",
    "check:shell": "node scripts/check-shell.mjs",
    "check:python-uv": "node scripts/check-python-uv.mjs",
    "check:root-scripts": "node scripts/regen-root-package.mjs --check",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:optimizer": "uv run --frozen --extra dev pytest -q",
    "audit:duplication": "node scripts/audit-duplication.mjs",
    "audit:specs": "node scripts/audit-spec-status.mjs",
    "survey:specs": "node scripts/audit-spec-status.mjs --survey",
    "audit:rubric": "node scripts/audit-rubric.mjs",
    "ci:local": "node scripts/ci-local.mjs",
    "purity": "node scripts/check-core-purity.mjs",
    "filesize": "node scripts/check-file-size.mjs",
    "check:beads": "bash scripts/check-beads.sh",
    "bd": "node scripts/beads-crud.mjs",
    "audit": "node scripts/audit-gate.mjs",
    "dup": "jscpd",
    "oxlint": "oxlint packages/*/src/",
    "publint": "publint packages/core && publint packages/diagram && publint packages/llm && publint packages/cli && publint packages/mcp",
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "validate:examples": "bash scripts/validate-examples.sh",
    "regen:examples": "bash scripts/regen-example-output.sh",
    "arch:triage": "node scripts/arch-triage.mjs",
    "prepare": "cd .. && husky barwise/.husky",
    "regen:tutorial": "node scripts/regen-tutorial.mjs",
    "regen:builtins": "node scripts/regen-builtin-artifacts.mjs",
    "regen:references": "node scripts/regen-references.mjs"
  },
  "devDependencies": {
    "@dprint/json": "0.23.0",
    "@dprint/markdown": "0.23.2",
    "@dprint/typescript": "0.96.1",
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^17.4.3",
    "dprint": "^0.57.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jscpd": "^5.1.1",
    "knip": "^5.86.0",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.81.0",
    "publint": "^0.3.24",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "*.ts": [
      "dprint fmt --allow-no-files --",
      "eslint --fix",
      "oxlint"
    ],
    "*.{json,md}": "dprint fmt --allow-no-files --",
    "*.mjs": [
      "dprint fmt --allow-no-files --",
      "oxlint"
    ],
    "*.sh": "shellcheck"
  },
  "packageManager": "npm@10.0.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
