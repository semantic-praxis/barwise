{
  "typescript": {
    "quoteStyle": "preferDouble",
    "semiColons": "always",
    "trailingCommas": "onlyMultiLine",
    "useTabs": false,
    "indentWidth": 2,
    "lineWidth": 100
  },
  "json": {
    "indentWidth": 2,
    "useTabs": false
  },
  "markdown": {
    "lineWidth": 80
  },
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/.turbo",
    "**/coverage",
    "**/*.orm.yaml",
    "docs/tutorial/**",
    "**/*.map.yaml",
    "**/*.orm-project.yaml",
    "**/package-lock.json",
    "**/schemas/**",
    "test-plan/**",
    "eval-payloads/**",
    "eval-runs/**"
  ],
  "plugins": [
    "./node_modules/@dprint/typescript/plugin.wasm",
    "./node_modules/@dprint/json/plugin.wasm",
    "./node_modules/@dprint/markdown/plugin.wasm"
  ]
}
