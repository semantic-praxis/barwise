# Supply-chain hardening -- see docs/specs/supply-chain-hardening.spec.md
#
# Installing a dependency otherwise executes its preinstall/install/
# postinstall scripts, which is how the 2025 registry worms propagated.
# npm has no per-package allowlist (pnpm's onlyBuiltDependencies), so the
# switch is all-or-nothing. Nothing in the tree needs it: dprint and
# esbuild are the only dependencies declaring an install script, and both
# resolve their platform binary through an optional dependency -- the
# script is an optimization, not a requirement.
#
# This also suppresses pre/post hooks for `npm run`. `npm run build` still
# runs `build`; a `postbuild` beside it silently does not. Scripts that
# must run are chained with && rather than declared as hooks.
ignore-scripts=true
